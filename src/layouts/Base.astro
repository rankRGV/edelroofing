---
import '@fontsource/crimson-text/400.css';
import '@fontsource/crimson-text/600.css';
import '@fontsource-variable/montserrat';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';
import { orgSchema } from '../data/schema';
import shareDefault from '../assets/projects/edel-roofing-pick-up-truck.jpeg';

interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'es';
  schema?: object[];
  // Paths of this page's EN and ES twins, e.g. { en: '/about-us', es: '/es-mx/about-us' }.
  alternates?: { en: string; es: string };
  // Pages that stay out of Google even after launch (ads landing, thank-you).
  noindex?: boolean;
  // false on the ads landing page: Roofle leads can't be tracked (Eddie, 2026-10-17).
  roofle?: boolean;
  // Header quote button target when it shouldn't open Roofle.
  quoteHref?: string;
  // Photo for link previews (Facebook, Messenger, texts). Defaults to the
  // truck photo the live site uses.
  image?: ImageMetadata;
}
const { title, description, lang = 'en', schema = [], alternates, noindex = false, roofle = true, quoteHref, image = shareDefault } = Astro.props;
// Preview on edelroofing.rankrgv.com stays out of Google until Edel approves
// and the site moves to edelroofing.com. Flip at launch, and add GTM / Ads /
// Meta Pixel then (left off the preview so test visits don't hit his data).
const PREVIEW = true;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), Astro.site);
const alt = alternates && { en: new URL(alternates.en, Astro.site).href, es: new URL(alternates.es, Astro.site).href };
// The sitewide RoofingContractor block goes on every page, like the live site.
const jsonLd = [orgSchema, ...schema];
const switchHref = alternates && (lang === 'es' ? alternates.en : alternates.es);
// Share image URL must be absolute and exist where the link is shared from:
// the preview host until launch, then edelroofing.com (follows PREVIEW).
const shareOrigin = PREVIEW ? 'https://edelroofing.rankrgv.com' : Astro.site;
const share = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const shareUrl = new URL(share.src, shareOrigin).href;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical.href} />
    {alt && <link rel="alternate" hreflang="en" href={alt.en} />}
    {alt && <link rel="alternate" hreflang="es" href={alt.es} />}
    {alt && <link rel="alternate" hreflang="x-default" href={alt.en} />}
    {PREVIEW ? <meta name="robots" content="noindex, nofollow" /> : noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#4f0000" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Edel Roofing & Construction" />
    <meta property="og:locale" content={lang === 'es' ? 'es_MX' : 'en_US'} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={shareUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <Header lang={lang} switchHref={switchHref} quoteHref={quoteHref} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} switchHref={switchHref} />
    {/* Roofle instant quote slide-out (same widget id as the live site) */}
    {roofle && (
      <Fragment>
    <script is:inline async src="https://app.roofle.com/roof-quote-pro-widget.js?id=EDm90hQNG9UzNzk4GqU84"></script>
    <script is:inline>
      // "Get Instant Quote" buttons open the Roofle slide-out when it has
      // loaded; otherwise the link goes to /contact-us (embedded Roofle).
      document.addEventListener('click', function (e) {
        var link = e.target.closest && e.target.closest('[data-roofle-open]');
        if (!link) return;
        var handle = document.querySelector('.quick-quote-button');
        if (!handle) return;
        e.preventDefault();
        var menu = link.closest('details');
        if (menu) menu.open = false;
        handle.click();
      });
    </script>
      </Fragment>
    )}
  </body>
</html>
