---
// /home-construction, rebuilt from the live Duda page (2026-10-18).
// Open question: does Edel still sell home construction? The page is off the
// live nav (2 inlinks). Rebuilt as is so the URL keeps working; not linked
// from the menu.
// Copy changes vs live:
// - "Your input is crucial" -> "Your input matters" (banned word).
// - Headings written in normal case (CSS uppercases them, same look).
// - "Over 25 years" kept as live (open question: vs "since 2003").
// - Added: breadcrumb, trust strip, quote/call buttons.
import InnerPage from '../layouts/InnerPage.astro';
import hero from '../assets/home-construction/modern-home.webp';
import pool from '../assets/home-construction/house-with-swimming-pool.jpg';
import kitchen from '../assets/home-construction/kitchen-construction.webp';
---
<InnerPage
  title="Home Construction Services | EDEL Roofing & Construction Inc."
  description="Transform your vision into reality with our trusted home construction services. We bring expertise, quality, and excellence to every project. Contact us today!"
  alternates={{ en: '/home-construction', es: '/es-mx/home-construction' }}
  crumbs={[
    { label: 'Home', href: '/' },
    { label: 'Home Construction', href: '/home-construction' },
  ]}
  hero={{ eyebrow: 'Our Construction Services', title: 'Home Construction', bg: hero }}
  intro={{
    eyebrow: 'Home Construction',
    title: 'Building Dreams',
    body: 'EDEL Roofing &amp; Construction is your partner in turning your dream home into a reality. Our <a href="/">Home Construction</a> services combine innovative design, quality craftsmanship, and attention to detail to create a space that embodies your vision, lifestyle, and aspirations.',
    cta: { label: 'Contact Us', href: '/contact-us' },
    images: [{ src: pool, alt: 'Home Construction' }],
  }}
  band={{
    eyebrow: 'Home Construction',
    title: 'Crafting Your Vision',
    body: "From the initial conceptualization to the final brick, our team of experts collaborates closely with you to bring your dream home to life. We understand that every detail matters, from the layout and materials to the finishing touches. Whether it's a modern masterpiece or a timeless classic, we have the expertise to transform your ideas into a tangible structure.",
    cta: { label: 'Get Instant Quote', href: '/contact-us', roofle: true },
    images: [{ src: kitchen, alt: 'Kitchen Construction' }],
  }}
  benefits={{
    title: 'Key Benefits of Our Construction Services',
    items: [
      { title: 'Experience and Expertise', body: 'With over 25 years in the industry, our experience shines through in every project we undertake.' },
      { title: 'Collaborative Approach', body: 'We believe in the power of teamwork. Your input matters, and we work closely with you throughout the construction process.' },
      { title: 'Craftsmanship and Integrity', body: 'Our commitment to excellence and transparency ensures that your home is built with the utmost care and precision.' },
    ],
  }}
  closing={{
    title: 'Crafting Your Dream Home',
    body: 'Your dream home is within reach with EDEL Roofing &amp; Construction. Let our Home Construction services be the foundation of your aspirations. Contact us today to discuss your project and take the first step towards a home that reflects your unique story.',
    cta: { label: 'Contact Us', href: '/contact-us' },
  }}
/>
