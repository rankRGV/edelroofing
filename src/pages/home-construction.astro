---
// /home-construction, rebuilt from the live Duda page (2026-10-18).
// Home construction is a real Edel service (2026-10-20 copy brief). The page
// is off the live nav (2 inlinks); not linked from the menu.
// Copy changes vs live:
// - "Your input is crucial" -> "Your input matters" (banned word).
// - Headings written in normal case (CSS uppercases them, same look).
// - Added: breadcrumb, trust strip, quote/call buttons.
// - 2026-10-20 copy pass: plain, warm rewrite; removed hype ("Building
//   Dreams", "dream home", "masterpiece", "transform", "innovative design",
//   "the power of teamwork", "utmost care"); "since 2003" replaces "over 25
//   years"; H1 and title now carry the Rio Grande Valley.
import InnerPage from '../layouts/InnerPage.astro';
import hero from '../assets/home-construction/modern-home.webp';
import pool from '../assets/home-construction/house-with-swimming-pool.jpg';
import kitchen from '../assets/home-construction/kitchen-construction.webp';
---
<InnerPage
  title="Home Construction in the RGV | EDEL Roofing & Construction"
  description="EDEL Roofing & Construction builds new homes in the Rio Grande Valley. We work with you on the layout, materials and finishes. Call (956) 422-3335 to talk."
  alternates={{ en: '/home-construction', es: '/es-mx/home-construction' }}
  crumbs={[
    { label: 'Home', href: '/' },
    { label: 'Home Construction', href: '/home-construction' },
  ]}
  hero={{ eyebrow: 'Construction', title: 'Home Construction in the Rio Grande Valley', bg: hero }}
  intro={{
    eyebrow: 'New homes',
    title: 'Building your new home',
    body: 'Building a house is a big decision, and you want a builder who listens. EDEL Roofing &amp; Construction offers <a href="/">home construction</a> in the Rio Grande Valley. We pay attention to the details and build the house around the way you and your family live.',
    cta: { label: 'Contact Us', href: '/contact-us' },
    images: [{ src: pool, alt: 'Home Construction' }],
  }}
  band={{
    eyebrow: 'How we work',
    title: "You're part of every step",
    body: "We work closely with you from the first plans through the last brick. The layout, the materials and the finishing touches all matter, and you get a say in each one. Modern or traditional, we build the style you want.",
    cta: { label: 'Talk to Us About Your Project', href: '/contact-us' },
    images: [{ src: kitchen, alt: 'Kitchen Construction' }],
  }}
  benefits={{
    title: 'Why build with Edel',
    items: [
      { title: 'In the Valley since 2003', body: 'Edel has been working in the Rio Grande Valley since 2003, and everything we have learned goes into each house we build.' },
      { title: 'We work with you', body: 'Your input matters. We stay in touch through the whole build and make the big decisions together with you.' },
      { title: 'Careful, honest work', body: 'We build with care, and we are open with you about the work and what it costs.' },
    ],
  }}
  closing={{
    title: 'Thinking about building?',
    body: 'Call EDEL Roofing &amp; Construction and tell us about the home you want to build. We will talk it through with you and explain the next steps.',
    cta: { label: 'Contact Us', href: '/contact-us' },
  }}
/>
