---
// /thank-you, rebuilt from the live Duda page (2026-10-18).
// Copy changes vs live:
// - No H1 on live (two H4s); the first line is now the H1.
// - <title> said "Contact Us | EDEL..."; now "Thank You | EDEL...".
// - Meta description had the old (956) 867-0667 number; now (956) 422-3335.
// - Address showed the old 3321 W Alberta Rd office; now 1815 N Jackson Rd.
// - Stray zero-width character before "Your message" removed.
// - Added: breadcrumb, quote/call buttons.
// - 2026-10-20 copy pass: plain, warm rewrite; meta description drops
//   "top-notch"; H1 and lead shortened; lead adds the phone and "We answer
//   24/7" (sheet fact).
// noindex since 2026-10-23 (pre-launch audit): it's a form confirmation, and
// GTM-W2Q2DSGP fires an Ads conversion on any URL with /thank-you, so a
// search visit here would count as a lead. Live had 79 impressions.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactCards from '../components/ContactCards.astro';
import { breadcrumbSchema } from '../data/schema';
import { site } from '../data/site';
import hero from '../assets/home/hero-roof.jpeg';

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Thank You', href: '/thank-you' },
];
---
<Base
  title="Thank You | EDEL Roofing & Construction Inc."
  description="Thanks for contacting EDEL Roofing & Construction Inc. in Edinburg. We will call you back soon. Need us now? Call (956) 422-3335."
  schema={[breadcrumbSchema(crumbs)]}
  noindex
>
  <PageHero
    crumbs={crumbs}
    title="Thank you. We got your message."
    lead={`Someone from our team will call you back soon. If it can't wait, call ${site.phone}. We answer 24/7.`}
    bg={hero}
  />
  <section class="section">
    <div class="wrap">
      <ContactCards />
    </div>
  </section>
</Base>

<style>
  .section { padding-block: 64px; }
</style>
