---
// /es-mx/commercial-roofing, rebuilt from the live Duda page (2026-10-18).
// Copy changes vs live:
// - <title> and meta description were English (meta had the old
//   (956) 867-0667 number); now Spanish with (956) 422-3335.
// - H1 "TECHOS Comerciales" written in normal case (CSS uppercases it).
// - "Servicios comprensivos" (means understanding) -> "Servicios completos".
// - Button "Consigue una cotización" (tú) -> "Pida una Cotización".
// - Dropped the Duda slider placeholders.
// - "más de dos décadas" and "25 años" kept as live (open question).
// - Added: links to the Spanish city commercial pages, breadcrumb, trust
//   strip, quote/call buttons, hreflang to /commercial-roofing.
// - Image alt text in Spanish (live used English alts).
// - 2026-10-20 copy pass: plain, warm rewrite in usted; "más de dos décadas"
//   and "legado de 25 años" -> "desde 2003"; removed hype ("expertos",
//   "inquebrantable", "excepcional", "de primera calidad", "de primer
//   nivel", "Transformando", "cualquier desafío"); H1/title now carry "Valle
//   del Río Grande"; Roofle button -> "Estimado al Instante".
import InnerPage from '../../layouts/InnerPage.astro';
import hero from '../../assets/commercial-roofing/roofing-construction.jpeg';
import building from '../../assets/commercial-roofing/commercial-building.jpg';
import commercial from '../../assets/commercial-roofing/commercial-roofing.jpeg';
import repair from '../../assets/commercial-roofing/commercial-roofing-repair.jpeg';
import repairing from '../../assets/commercial-roofing/repairing-commercial-roof.jpeg';
import { site } from '../../data/site';

// 2026-10-21: mismas certificaciones comerciales que /commercial-roofing
// (hoja de certificaciones de Dustin).
const certs = [
  `Contratista de techos con licencia en Texas (${site.license})`,
  'Versico Authorized Contractor',
  'Polyglass Registered Contractor',
  'KARNAK',
  'Duro-Last',
  'GAF',
  'Owens Corning Preferred Contractor',
];
---
<InnerPage
  lang="es"
  title="Techos Comerciales en el Valle del Río Grande | EDEL Roofing & Construction"
  description="Techos comerciales nuevos, reparación y reemplazo en Edinburg y el Valle del Río Grande desde 2003. Techos de poca pendiente y techos inclinados. Llame al (956) 422-3335."
  trustCert="Contratista Versico Authorized y Polyglass Registered"
  alternates={{ en: '/commercial-roofing', es: '/es-mx/commercial-roofing' }}
  crumbs={[
    { label: 'Inicio', href: '/es-mx' },
    { label: 'Techos Comerciales', href: '/es-mx/commercial-roofing' },
  ]}
  hero={{ eyebrow: 'Nuestros Servicios de Techado', title: 'Techos Comerciales en el Valle del Río Grande', bg: hero }}
  intro={{
    eyebrow: 'Techos para negocios',
    title: 'Techos comerciales desde 2003',
    body: 'EDEL Roofing &amp; Construction Inc. trabaja techos comerciales en el Valle del Río Grande desde 2003. Su edificio es una inversión grande, y una gotera afecta a sus clientes, a su mercancía y a su día de trabajo. Por eso un techo en buen estado importa tanto. Instalamos techos comerciales nuevos y también hacemos reparaciones, mantenimiento y reemplazos para negocios en todo el Valle.',
    cta: { label: 'Contáctenos', href: '/es-mx/contact-us' },
    images: [{ src: building, alt: 'Edificio comercial' }],
  }}
  band={{
    eyebrow: 'Instalación de Techo Comercial',
    title: 'Cómo trabajamos',
    body: 'Eddie Elizondo fundó EDEL con una idea que no ha cambiado: construir bien y tratar bien al cliente. Nuestros techadores tienen años de experiencia en techos comerciales. Trabajamos con buenos materiales y los instalamos con cuidado, para que el techo de su negocio dure muchos años.',
    cta: { label: 'Estimado al Instante', href: '/es-mx/contact-us#contacto', roofle: true },
    images: [
      { src: commercial, alt: 'Techo comercial' },
      { src: repair, alt: 'Reparación de techo comercial' },
      { src: repairing, alt: 'Reparando un techo comercial' },
    ],
  }}
  benefits={{
    title: 'Por qué elegir a EDEL para el techo de su negocio',
    items: [
      { title: 'Techos de poca pendiente y techos inclinados', body: 'Un edificio comercial puede tener cualquier tipo de techo: TPO, bitumen modificado, EPDM, PVC, tejas asfálticas, teja o metal. Trabajamos con todos, desde instalaciones nuevas hasta <a href="/es-mx/roof-repairs">reparaciones</a>, mantenimiento y reemplazo.' },
      { title: 'Experiencia', body: 'Nuestro equipo trabaja proyectos comerciales de todos los tamaños, sencillos y complicados. Si su techo tiene un problema, lo revisamos y le explicamos qué opciones tiene.' },
      { title: 'Buenos materiales', body: 'Compramos los materiales con proveedores de confianza. Escogemos materiales que aguanten el uso que recibe un techo comercial y que le duren.' },
    ],
  }}
  spokes={{
    title: 'Techado Comercial por Ciudad',
    intro: 'Vea lo que hacemos en techos comerciales en su ciudad.',
    links: [
      { href: '/commercial-roofing-edinburg-tx-es', label: 'Techado Comercial en Edinburg, TX' },
      { href: '/techado-comercial-mcallen-tx', label: 'Techado Comercial en McAllen, TX' },
      { href: '/techado-comercial-mission-tx', label: 'Techado Comercial en Mission, TX' },
    ],
  }}
  closing={{
    title: '¿Tiene un problema con el techo de su negocio?',
    body: 'Llame a EDEL Roofing &amp; Construction Inc. y cuéntenos qué está pasando. La consulta es gratis, y antes de empezar le entregamos un presupuesto por escrito con el trabajo y el precio. Atendemos negocios en Edinburg, McAllen, Mission y el resto del Valle del Río Grande.',
    cta: { label: 'Contáctenos', href: '/es-mx/contact-us' },
  }}
>
  <section class="certs">
    <div class="wrap">
      <h2>Licencia y certificaciones comerciales</h2>
      <ul>
        {certs.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </section>
</InnerPage>

<style>
  .certs { padding-block: 72px; text-align: center; }
  .certs h2 { font-size: clamp(28px, 3.5vw, 42px); text-transform: uppercase; }
  .certs ul { list-style: none; margin: 28px auto 0; padding: 0; max-width: 960px; display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  .certs li { padding: 12px 18px; background: var(--white); border: 1px solid var(--line); border-top: 3px solid var(--maroon); border-radius: var(--radius); font-weight: 600; color: var(--ink); }
  @media (max-width: 900px) { .certs { padding-block: 56px; } }
</style>
