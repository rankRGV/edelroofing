  description="EDEL Roofing & Construction Inc. en el Valle del Río Grande: vea nuestros proyectos de techos, remodelación y construcción. ¡Llame hoy al (956) 422-3335!"
  lang="es"
  alternates={{ en: '/projects', es: '/es-mx/projects' }}
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero crumbs={crumbs} eyebrow="Galería" title="Nuestros Proyectos" bg={hero} lang="es" />
  <TrustStrip lang="es" />

  <ProjectGallery photos={order} lang="es" />

