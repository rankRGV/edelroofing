---
// /es-mx/residential-roofing, rebuilt from the live Duda page (2026-10-18).
// Copy changes vs live (same fixes as the EN twin):
// - <title> and meta description were English (meta had the old
//   (956) 867-0667 number); now Spanish with (956) 422-3335.
// - "combina a la perfección" -> "combina" (EN "seamlessly", banned).
// - Band heading "Eleve el escudo de su propiedad" -> "Fortalezca el escudo
//   de su propiedad"; closing "Eleva tu propiedad" -> "Proteja y mejore su
//   propiedad" (elevate as a headline verb is banned; usted, as the page).
// - "sea un testimonio de una artesanía excepcional" -> "muestre una
//   artesanía excepcional" (testament, banned).
// - Button "Consigue una cotización" (tú) -> "Pida una Cotización".
// - Dropped the Duda slider placeholders ("Título de la diapositiva").
// - Added: links to the Spanish city roof replacement pages, breadcrumb,
//   trust strip, quote/call buttons, hreflang to /residential-roofing.
// - Image alt text in Spanish (live used English alts).
import InnerPage from '../../layouts/InnerPage.astro';
import hero from '../../assets/residential-roofing/house-with-swimming-pool.jpg';
import construction from '../../assets/residential-roofing/roofing-construction.jpeg';
import install from '../../assets/residential-roofing/roof-installation-residential.jpeg';
import residential from '../../assets/residential-roofing/residential-roofing.jpeg';
import newRoof from '../../assets/residential-roofing/new-residential-roof.jpeg';
---
<InnerPage
  lang="es"
  title="Techos Residenciales en Edinburg, TX | EDEL Roofing & Construction Inc."
  description="EDEL Roofing & Construction Inc. en el Valle del Río Grande: su mejor opción para techos residenciales. ¡Llame hoy al (956) 422-3335!"
  alternates={{ en: '/residential-roofing', es: '/es-mx/residential-roofing' }}
  crumbs={[
    { label: 'Inicio', href: '/es-mx' },
    { label: 'Techos Residenciales', href: '/es-mx/residential-roofing' },
  ]}
  hero={{ eyebrow: 'Nuestros Servicios de Techado', title: 'Techos Residenciales', bg: hero }}
  intro={{
    eyebrow: 'Transformando Techos',
    title: 'Donde la durabilidad se une a la elegancia',
    body: 'EDEL Roofing &amp; Construction Inc. le ofrece un enfoque distintivo para techos residenciales que combina durabilidad con elegancia estética. Nuestros servicios de techado residencial están diseñados para ofrecer algo más que un techo funcional: nuestro objetivo es crear una característica destacada que mejore el valor y el atractivo general de su propiedad.',
    cta: { label: 'Contáctenos', href: '/es-mx/contact-us' },
    images: [{ src: construction, alt: 'Construcción de techo' }],
  }}
  band={{
    eyebrow: 'Instalación de Techo',
    title: 'Fortalezca el escudo de su propiedad',
    body: 'Nuestro servicio de Instalación de Techos va más allá de los conceptos básicos de la construcción; se trata de crear un escudo robusto que no sólo proteja su propiedad sino que también eleve su atractivo exterior. En EDEL Roofing &amp; Construction, fusionamos precisión, materiales de primera calidad y mano de obra experta para construir techos que resisten el paso del tiempo. Desde el concepto hasta la teja final, priorizamos la durabilidad, la estética y su visión única, asegurando que cada instalación se convierta en una obra maestra que corone su propiedad con distinción.',
    cta: { label: 'Pida una Cotización', href: '/es-mx/contact-us', roofle: true },
    images: [
      { src: install, alt: 'Instalación de techo residencial' },
      { src: residential, alt: 'Techo residencial' },
      { src: newRoof, alt: 'Techo residencial nuevo' },
    ],
  }}
  benefits={{
    title: 'Beneficios clave de nuestros servicios de techado',
    items: [
      { title: 'Soluciones de techado personalizadas', body: 'Ofrecemos una amplia gama de materiales y estilos, desde tejas de asfalto hasta techos de metal, para satisfacer las necesidades tanto residenciales como comerciales.' },
      { title: 'Opciones energéticamente eficientes', body: 'Nuestras soluciones para techos no solo protegen su propiedad sino que también ofrecen una mayor eficiencia energética, lo que le ayuda a ahorrar significativamente en facturas de servicios públicos.' },
      { title: 'Durabilidad a largo plazo', body: 'Utilizamos materiales de alta calidad y técnicas de instalación expertas para garantizar que su techo resista el paso del tiempo, agregando valor a su propiedad.' },
    ],
  }}
  spokes={{
    title: 'Reemplazo de Techo por Ciudad',
    intro: '¿Busca un techo nuevo en una ciudad en particular? Estas páginas cubren el reemplazo de techo y los canalones ciudad por ciudad.',
    links: [
      { href: '/reemplazo-de-techo-en-edinburg-tx', label: 'Reemplazo de Techo en Edinburg, TX' },
      { href: '/reemplazo-de-techo-mcallen-tx', label: 'Reemplazo de Techo en McAllen, TX' },
      { href: '/reemplazo-de-techo-mission-tx', label: 'Reemplazo de Techo en Mission, TX' },
      { href: '/gutters-edinburg-tx-es', label: 'Instalación y Reparación de Canalones en Edinburg, TX' },
    ],
  }}
  closing={{
    title: 'Proteja y mejore su propiedad',
    body: 'Cuando opta por EDEL Roofing &amp; Construction para sus necesidades de techado residencial, está seleccionando un socio comprometido a mejorar tanto la solidez estructural como el atractivo visual de su propiedad. Eleve su hogar con un techo que no solo cumpla su propósito sino que también muestre una artesanía excepcional.',
    cta: { label: 'Contáctenos', href: '/es-mx/contact-us' },
  }}
/>
