---
// /es-mx/roof-repairs, rebuilt from the live Duda page (2026-10-18).
// Copy changes vs live:
// - <title> and meta description were English (meta had the old
//   (956) 867-0667 number); now Spanish with (956) 422-3335.
// - H1 "REPARACIONES DE TECHO" written in normal case (CSS uppercases it).
// - Button "Consigue una cotización" (tú) -> "Pida una Cotización".
// - Added: links to the Spanish city roof repair pages, breadcrumb, trust
//   strip, quote/call buttons, hreflang to /roof-repairs.
// - Image alt text in Spanish (live used English alts).
import InnerPage from '../../layouts/InnerPage.astro';
import hero from '../../assets/roof-repairs/modern-house.jpeg';
import restoration from '../../assets/roof-repairs/roof-restoration.jpeg';
import repair from '../../assets/roof-repairs/roof-repair.jpeg';
---
<InnerPage
  lang="es"
  title="Reparaciones de Techo | EDEL Roofing & Construction Inc."
  description="EDEL Roofing & Construction Inc.: su mejor opción para reparaciones de techo en el Valle del Río Grande. ¡Llame al (956) 422-3335 hoy!"
  alternates={{ en: '/roof-repairs', es: '/es-mx/roof-repairs' }}
  crumbs={[
    { label: 'Inicio', href: '/es-mx' },
    { label: 'Reparaciones de Techo', href: '/es-mx/roof-repairs' },
  ]}
  hero={{ eyebrow: 'Nuestros Servicios de Techado', title: 'Reparaciones de Techo', bg: hero }}
  intro={{
    eyebrow: 'Reparaciones de Techo',
    title: 'Restaurar fuerza y protección',
    body: 'EDEL Roofing &amp; Construction comprende la urgencia de un techo con goteras, tejas dañadas o cualquier problema imprevisto en el techo. Nuestro servicio de reparación de techos está diseñado para abordar rápidamente estas inquietudes, brindando soluciones oportunas que no solo restablecen la integridad de su techo sino también su tranquilidad.',
    cta: { label: 'Contáctenos', href: '/es-mx/contact-us' },
    images: [{ src: restoration, alt: 'Restauración de techo' }],
  }}
  band={{
    eyebrow: 'Nuestro Enfoque',
    title: 'Reparaciones Integrales de Techos',
    body: 'Con un equipo de profesionales experimentados y un compromiso con la excelencia, abordamos las reparaciones de techos con una perspectiva integral. No solo solucionamos los problemas visibles sino que también diagnosticamos las causas subyacentes, asegurando una solución duradera que prevenga problemas futuros.',
    cta: { label: 'Pida una Cotización', href: '/es-mx/contact-us', roofle: true },
    images: [{ src: repair, alt: 'Reparación de techo' }],
  }}
  benefits={{
    title: 'Beneficios clave de nuestros servicios de reparación',
    items: [
      { title: 'Detección y reparación de fugas', body: 'Nuestros expertos emplean técnicas avanzadas para identificar y reparar fugas, previniendo daños por agua y preservando la integridad estructural de su propiedad.' },
      { title: 'Reemplazo de tejas', body: 'Las tejas dañadas o faltantes comprometen la defensa de su techo. Nuestros servicios de reemplazo de tejas restauran el aspecto y la protección de su techo.' },
      { title: 'Reparaciones de emergencia', body: '¿Daños por tormentas o fugas inesperadas? Nuestro equipo de respuesta rápida está equipado para manejar <a href="/es-mx/contact-us">reparaciones de emergencia</a>, minimizando daños mayores a su propiedad.' },
    ],
  }}
  spokes={{
    title: 'Reparación de Techo por Ciudad',
    intro: 'Cada una de estas páginas cubre la reparación de techos en una ciudad.',
    links: [
      { href: '/reparacion-de-techo-edinburg-tx', label: 'Reparación de Techo en Edinburg, TX' },
      { href: '/reparacion-de-techo-mcallen-tx', label: 'Reparación de Techo en McAllen, TX' },
      { href: '/reparacion-de-techo-mission-tx', label: 'Reparación de Techo en Mission, TX' },
      { href: '/es-mx/storm-damage', label: 'Daño de la Tormenta' },
    ],
  }}
  closing={{
    title: 'Asegure su propiedad',
    body: 'No permita que los problemas del techo comprometan su seguridad y comodidad. Elija EDEL Roofing &amp; Construction para reparaciones de techos expertas que resistan la prueba del tiempo. Contáctenos hoy para programar una consulta y dar el primer paso para restaurar la resistencia y protección de su techo.',
    cta: { label: 'Contáctenos', href: '/es-mx/contact-us' },
  }}
/>
