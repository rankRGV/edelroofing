---
// Homepage, rebuilt from the live Duda page (edelroofing.com, 2026-10-18).
// Copy is the live copy. Changes: the license number and the hours line were
// broken on the live page (a phone-number find/replace hit them), em dashes
// swapped for commas/periods, McAllen + Mission area cards now link to their
// city pages, review counts use the live Google total (4.8, 257 on 2026-10-18),
// and the hero follows the mobile-first first-screen pattern (2026-10-18).
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site, addressLine } from '../data/site';

import heroRoof from '../assets/home/hero-roof.jpeg';
import heroProjects from '../assets/home/hero-projects.png';
import texasRegional from '../assets/home/texas-regional.webp';
import truckHouse from '../assets/home/truck-house.jpeg';
import residential from '../assets/home/residential.jpg';
import commercial from '../assets/home/commercial.jpeg';
import repairs from '../assets/home/repairs.jpg';
import ctaBg from '../assets/home/cta-background.webp';
import certainteed from '../assets/badges/certainteed-select-shinglemaster.png';
import owensCorning from '../assets/badges/owens-corning-preferred.webp';
import rcat from '../assets/badges/rcat.webp';
import nrca from '../assets/badges/nrca.webp';
import bbb from '../assets/badges/bbb.webp';
import google5 from '../assets/badges/google-5-star.png';
import readers2019 from '../assets/badges/readers-choice-2019.jpg';
import readers2018 from '../assets/badges/readers-choice-2018.jpg';

const bg = async (src: ImageMetadata, width = 1920) =>
  (await getImage({ src, width, format: 'webp', quality: 72 })).src;
const heroBg = await bg(heroRoof);
const truckBg = await bg(truckHouse);
const ctaBgSrc = await bg(ctaBg);

const services = [
  {
    eyebrow: 'Residential',
    title: 'Residential roofing in Edinburg',
    body: 'Trust Edel Roofing & Construction for all your residential roofing needs. With over 25 years of experience and a steadfast commitment to quality, our skilled professionals excel in repairs and installations. We focus on the safety and comfort of your home, ensuring a roof that stands the test of time.',
    href: '/residential-roofing',
    img: residential,
    alt: 'Large white house with a blue roof',
  },
  {
    eyebrow: 'Commercial',
    title: 'Commercial Roofing in Edinburg',
    body: "Edel Roofing & Construction is your go-to partner for commercial roofing solutions. Rooted in 25 years of expertise and recognized by multiple Reader's Choice Awards, we specialize in crafting durable, high-quality roofs that offer both protection and aesthetic appeal for your business.",
    href: '/commercial-roofing',
    img: commercial,
    alt: 'Commercial building roof',
  },
  {
    eyebrow: 'Repairs',
    title: 'Roof Repair in Edinburg',
    body: 'Roof damage, whether from storms or wear and tear, requires prompt attention. Our roof repair in Edinburg, TX, focuses on identifying issues early and providing efficient fixes to prevent further damage. From minor leaks to significant damage, our team ensures your roof is restored to optimal condition, safeguarding your home against future weather events.',
    href: '/roof-repairs',
    img: repairs,
    alt: 'House with a blue roof',
  },
];

const areas: { name: string; href?: string; home?: boolean }[] = [
  { name: 'Edinburg', href: '/', home: true },
  { name: 'McAllen', href: '/roofing-mcallen-tx' },
  { name: 'Mission', href: '/roofing-mission-tx' },
  { name: 'Pharr' },
  { name: 'Weslaco' },
  { name: 'Harlingen' },
  { name: 'Brownsville' },
  { name: 'Rio Grande City' },
];

const badges = [
  { src: owensCorning, alt: 'Owens Corning Preferred Contractor', href: 'https://www.owenscorning.com/en-us' },
  { src: rcat, alt: 'Roofing Contractors Association of Texas' },
  { src: nrca, alt: 'National Roofing Contractors Association' },
  { src: bbb, alt: 'BBB' },
  { src: google5, alt: 'Google 5 Star' },
  { src: readers2019, alt: "Readers' Choice Award 2019" },
  { src: readers2018, alt: "Readers' Choice Award 2018" },
];

const faqs = [
  {
    q: 'Do you offer free roof inspections in Edinburg?',
    a: `Yes. We provide free roof inspections and estimates across Edinburg and the Rio Grande Valley. Call <a href="${site.phoneHref}">${site.phone}</a> or <a href="/book-an-inspection">book an inspection online</a>.`,
  },
  {
    q: 'How long does a roof replacement take?',
    a: 'Most residential roof replacements take one to two days, depending on the size of the roof and the roofing material. We give you a clear timeline before we start.',
  },
  {
    q: 'What roofing brands do you install?',
    a: 'We install CertainTeed, Owens Corning, and GAF, among others. Edel is the only CertainTeed Select ShingleMaster in the Rio Grande Valley.',
  },
  {
    q: 'Are you licensed and insured?',
    a: `Yes. Edel Roofing & Construction is licensed (${site.license}), bonded, and insured.`,
  },
  {
    q: 'What areas do you serve?',
    a: `We're based in Edinburg and serve McAllen, Mission, Pharr, Weslaco, Harlingen, Brownsville, and Rio Grande City. <a href="/service-areas">See all areas we serve</a>.`,
  },
  {
    q: 'Do you offer financing?',
    a: 'Yes. We offer financing options for roof replacement and repairs. <a href="/financing">See financing</a>.',
  },
];

const strip = (html: string) => html.replace(/<[^>]+>/g, '');
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.legalName, url: 'https://www.edelroofing.com/' },
  // RoofingContractor block comes from Base (src/data/schema.ts).
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: strip(f.a) },
    })),
  },
];
---
<Base
  title="Edinburg Roofing Contractor | Edel Roofing & Construction"
  description="Licensed roof replacement, repairs, and commercial roofing in Edinburg, McAllen, and the Rio Grande Valley. Free estimates. Call (956) 422-3335."
  schema={schema}
  alternates={{ en: '/', es: '/es-mx' }}
>
  <!-- Hero: rating, H1, two reassurances, two sentences, quote box. -->
  <section class="hero" style={`--bg: url(${heroBg})`}>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <a class="rating" href={site.googleMaps} rel="noopener" target="_blank">
          <span class="stars" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Icon name="star" />)}</span>
          <span>Rated <strong>4.8</strong> by 250+ Google reviews</span>
        </a>
        <h1>Edinburg Roofing Contractor Serving the Rio Grande Valley</h1>
        <ul class="assure">
          <li><Icon name="clipboard" />Free inspection &amp; written estimate</li>
          <li><Icon name="badge" />Only CertainTeed Select ShingleMaster in the RGV</li>
        </ul>
        <p class="hero-text">
          Roofing the Valley since 2003, licensed and insured ({site.license}). Call or request a quote and we set
          up a free inspection, with a written price before any work starts.
        </p>
      </div>

      <div class="hero-side">
        <Image
          class="hero-art"
          src={heroProjects}
          alt="Roofs Edel Roofing has completed in the Rio Grande Valley"
          widths={[320, 480, 640]}
          sizes="420px"
          loading="eager"
        />
        <div class="quote-card">
          <p class="pill"><span class="dot"></span>Free roof inspections</p>
          <h2>Get your roof price online</h2>
          <p>Answer a few questions about your home and see an instant estimate. No phone call needed.</p>
          <a class="btn btn--big" href="/contact-us" data-roofle-open>Get Instant Quote</a>
          <a class="btn btn--ghost btn--big" href={site.phoneHref}><Icon name="phone" />Call {site.phone}</a>
          <p class="hablamos">Se habla español</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Protecting your roof + reviews -->
  <section class="section intro">
    <div class="wrap center">
      <p class="eyebrow">Professional roofing services in the Rio Grande Valley</p>
      <h2>Protecting Your Roof &amp; Your Home</h2>
      <p class="lead">Find out why Rio Grande Valley residents choose EDEL Roofing for all their roofing needs.</p>
      <a class="btn" href="/contact-us">Get a Quote</a>
    </div>
    <div class="wrap reviews">
      <div class="embedsocial-widget" data-ref="3334f1835841370bbe53f44efa6b8f74"></div>
    </div>
    <div class="wrap">
      <p class="intro-copy">
        Edel Roofing and Construction Inc is a trusted roofing company in Edinburg, TX, providing top-tier roofing
        solutions tailored to the unique challenges of the Rio Grande Valley. With years of experience, our team
        understands the specific needs of homeowners in this region, offering services that ensure durability and
        protection against the local climate.
      </p>
    </div>
  </section>

  <!-- Specialist -->
  <section class="section soft">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Edel Roofing &amp; Construction</p>
        <h2>Edinburg's Specialist Roofing Company</h2>
        <p>
          At Edel Roofing and Construction, we specialize in roofing services to ensure total protection for your
          home. As an Owens Corning preferred contractor, we use the highest quality materials and follow all
          industry standards to ensure that your whole roofing process is done properly.
        </p>
        <ul class="features">
          <li><Icon name="roof" /><span>Over 25 Years of Experience</span></li>
          <li><Icon name="users" /><span>Servicing Rio Grande Valley Communities</span></li>
          <li><Icon name="shield" /><span>Licensed, Insured &amp; Bonded</span></li>
        </ul>
        <a class="btn" href="/about-us">Learn More</a>
      </div>
      <Image
        class="rounded"
        src={texasRegional}
        alt="Metal roof on a commercial building in the Rio Grande Valley"
        widths={[480, 760, 1000]}
        sizes="(max-width: 900px) 100vw, 560px"
      />
    </div>
  </section>

  <!-- Why choose -->
  <section class="section photo-band" style={`--bg: url(${truckBg})`}>
    <div class="wrap center">
      <h2>Why Edinburg Chooses Edel</h2>
      <p class="sub">Why choose Edel Roofing and Construction for your next project?</p>
      <div class="why-grid">
        <div>
          <Icon name="badge" />
          <h3>Licensed &amp; Certified</h3>
          <p>
            Fully licensed ({site.license}), bonded, and insured, and the only CertainTeed Select ShingleMaster in the
            Rio Grande Valley.
          </p>
        </div>
        <div>
          <Icon name="star" />
          <h3>250+ Google Reviews</h3>
          <p>Roofing the Valley since 2003, with a 4.8-star rating from more than 250 homeowners and businesses.</p>
        </div>
        <div>
          <Icon name="clipboard" />
          <h3>Free Inspections &amp; Clear Estimates</h3>
          <p>We start with a free inspection and a written estimate. You know the scope and the price before we begin.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section">
    <div class="wrap center">
      <h2>Our Roofing Services</h2>
      <p class="lead">
        Roofing built to last across Edinburg and the Rio Grande Valley: replacement, repairs, and commercial
        roofing, done right.
      </p>
    </div>
    <div class="wrap services">
      {services.map((s, i) => (
        <article class:list={['service', { flip: i % 2 === 1 }]}>
          <Image src={s.img} alt={s.alt} widths={[400, 640, 900]} sizes="(max-width: 900px) 100vw, 520px" class="rounded" />
          <div>
            <p class="eyebrow">{s.eyebrow}</p>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
            <a class="btn" href={s.href}>Learn More</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Areas -->
  <section class="section warm">
    <div class="wrap center">
      <p class="eyebrow">Areas We Serve</p>
      <h2>Roofing Across the Rio Grande Valley</h2>
      <p class="lead">
        We're based in Edinburg and serve homeowners and businesses across the RGV: roof replacement, commercial
        roofing, and repairs. Choose your city to learn more.
      </p>
      <ul class="areas">
        {areas.map((a) => (
          <li>
            {a.href ? (
              <a class:list={['area', { home: a.home }]} href={a.href}>
                {a.name}{a.home && <small>Home base</small>}
              </a>
            ) : (
              <span class="area">{a.name}</span>
            )}
          </li>
        ))}
      </ul>
      <a class="btn" href="/service-areas">See all areas we serve</a>
      <p class="small">
        Not sure if we cover your area? Call <a href={site.phoneHref}>{site.phone}</a>. If you're in the Rio Grande
        Valley, we can help.
      </p>
    </div>
  </section>

  <!-- Why trust -->
  <section class="section photo-band short" style={`--bg: url(${truckBg})`}>
    <div class="wrap center narrow">
      <h2>Why Edinburg Homeowners Trust Edel Roofing and Construction Inc</h2>
      <p>
        We've been roofing Edinburg and the Rio Grande Valley since 2003. Our crews know the local building codes and
        what the Valley's heat, wind, and storm season do to a roof, so every roof we install is built to hold up
        here. Licensed, insured, and backed by 250+ Google reviews from your neighbors.
      </p>
    </div>
  </section>
  <section class="badges-band">
    <ul class="wrap badges">
      {badges.map((b) => (
        <li>
          {b.href ? (
            <a href={b.href} rel="noopener" target="_blank"><Image src={b.src} alt={b.alt} height={90} /></a>
          ) : (
            <Image src={b.src} alt={b.alt} height={90} />
          )}
        </li>
      ))}
    </ul>
  </section>

  <!-- Certified + map -->
  <section class="section soft">
    <div class="wrap split">
      <div>
        <h2>Certified Excellence</h2>
        <p>
          EDEL Roofing &amp; Construction Inc. proudly holds the exclusive title of being the only CertainTeed Select
          ShingleMaster in the Rio Grande Valley area. This prestigious certification reflects our commitment to
          unparalleled roofing expertise, ensuring top-notch quality for your roofing projects. Trust the best for
          your home. Choose EDEL Roofing &amp; Construction Inc.
        </p>
        <Image src={certainteed} alt="CertainTeed Select ShingleMaster" width={160} />
      </div>
      <div>
        <div class="map">
          <iframe
            title="Map to Edel Roofing & Construction in Edinburg, TX"
            src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d23667.384708486312!2d-98.2055292!3d26.2596735!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8665a146c4b26d97%3A0x676b08ea4b4d1f8c!2sEDEL%20Roofing%20and%20Construction%20Inc.!5e1!3m2!1sen!2sus!4v1747828235672!5m2!1sen!2sus"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen></iframe>
        </div>
        <p class="small">{addressLine}</p>
        <p class="small">
          For additional questions or more information, call us at <a href={site.phoneHref}>{site.phone}</a> or find us
          on <a href={site.yelp} rel="noopener" target="_blank">Yelp</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta" style={`--bg: url(${ctaBgSrc})`}>
    <div class="wrap cta-row">
      <div>
        <h2>We've Got You Covered</h2>
        <p>
          Ready to start your roofing, remodeling, or construction journey? Contact Eddie Elizondo and the EDEL team
          today. Let's turn your dreams into reality.
        </p>
      </div>
      <a class="btn btn--light" href={site.phoneHref}>Call Us Today {site.phone}</a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section warm">
    <div class="wrap faq-wrap">
      <div class="center">
        <p class="eyebrow">Questions? Answered.</p>
        <h2>Frequently Asked Questions</h2>
      </div>
      <div class="faqs">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}<Icon name="plus" /></summary>
            <p set:html={f.a} />
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<script is:inline>
  (function (d, s, id) {
    if (d.getElementById(id)) return;
    var js = d.createElement(s);
    js.id = id;
    js.src = 'https://embedsocial.com/cdn/aht.js';
    d.getElementsByTagName('head')[0].appendChild(js);
  })(document, 'script', 'EmbedSocialWidgetScript');
</script>

<style>
  .section { padding-block: 88px; }
  .soft { background: var(--bg-soft); }
  .warm { background: var(--bg-warm); }
  .center { text-align: center; }
  .center .eyebrow { justify-content: center; }
  .narrow { max-width: 860px; }
  .lead { max-width: 62ch; margin: 0 auto 1.6rem; }
  .small { font-size: 14px; margin-top: 1rem; }
  .rounded { border-radius: var(--radius); width: 100%; object-fit: cover; }
  h2 {
    font-size: clamp(32px, 4.4vw, 52px);
    text-transform: uppercase;
  }

  /* Hero */
  .hero {
    position: relative;
    isolation: isolate;
    color: var(--white);
    background: var(--maroon-dark) var(--bg) center / cover no-repeat;
    padding-block: 56px 72px;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(100deg, rgba(45, 0, 1, 0.92) 0%, rgba(45, 0, 1, 0.82) 50%, rgba(45, 0, 1, 0.45) 100%);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: center;
  }
  .rating {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 16px;
    color: var(--white);
    text-decoration: none;
    margin-bottom: 18px;
  }
  .rating:hover span:last-child { text-decoration: underline; }
  .stars { display: inline-flex; gap: 2px; color: #f5b301; }
  .stars :global(svg) { width: 22px; height: 22px; }
  .hero h1 {
    font-size: clamp(38px, 4.8vw, 60px);
    font-weight: 600;
    line-height: 1.08;
    color: var(--white);
    margin-bottom: 22px;
    max-width: 16ch;
  }
  .assure { list-style: none; margin: 0 0 20px; padding: 0; display: grid; gap: 10px; }
  .assure li { display: flex; align-items: center; gap: 10px; font-size: 16px; font-weight: 600; }
  .assure :global(svg) { width: 22px; height: 22px; flex: none; color: #f2c4c8; }
  .hero-text { font-size: 17px; max-width: 46ch; color: rgba(255, 255, 255, 0.9); margin: 0; }

  .hero-side { position: relative; display: grid; justify-items: center; }
  .hero-art { width: 100%; max-width: 380px; margin-bottom: -110px; }
  .quote-card {
    position: relative;
    width: 100%;
    max-width: 440px;
    background: var(--white);
    color: var(--ink);
    border-radius: 14px;
    padding: 26px 26px 20px;
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.28);
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 12px;
    padding: 6px 14px;
    border-radius: 999px;
    background: #f6eaeb;
    color: var(--maroon);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--maroon-mid); }
  .quote-card h2 {
    font-size: 30px;
    text-transform: none;
    color: var(--maroon);
    margin-bottom: 8px;
  }
  .quote-card p { font-size: 15px; }
  .btn--big { display: flex; width: 100%; min-height: 56px; font-size: 16px; gap: 8px; margin-top: 10px; }
  .btn--big :global(svg) { width: 18px; height: 18px; }
  .hablamos { margin: 12px 0 0; text-align: center; font-size: 14px; font-weight: 600; color: var(--muted); }

  /* Intro + reviews */
  .reviews { margin-top: 48px; min-height: 240px; }
  .intro-copy { max-width: 900px; margin: 40px auto 0; text-align: center; font-size: 16px; }

  /* Split */
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .features {
    list-style: none;
    padding: 0;
    margin: 28px 0 32px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .features li { display: flex; flex-direction: column; gap: 10px; font-family: var(--font-head); font-size: 20px; line-height: 1.2; color: var(--ink); }
  .features :global(svg) { width: 34px; height: 34px; color: var(--maroon); }

  /* Photo band */
  .photo-band {
    position: relative;
    color: var(--white);
    background: var(--maroon-dark) var(--bg) center / cover no-repeat;
    isolation: isolate;
  }
  .photo-band::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(79, 0, 0, 0.78);
    z-index: -1;
  }
  .photo-band h2, .photo-band h3 { color: var(--white); }
  .photo-band .sub { letter-spacing: 0.15em; text-transform: uppercase; font-size: 14px; margin-bottom: 48px; }
  .photo-band.short { padding-block: 72px; }
  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 36px;
  }
  .why-grid h3 { font-size: 30px; text-transform: uppercase; margin-top: 14px; }
  .why-grid :global(svg) { width: 40px; height: 40px; }
  .why-grid p { max-width: 34ch; margin-inline: auto; }

  /* Services */
  .services { display: grid; gap: 64px; margin-top: 40px; }
  .service {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .service :global(img) { aspect-ratio: 465 / 400; }
  .service.flip > :global(img) { order: 2; }
  .service h3 { font-size: clamp(30px, 3.6vw, 44px); text-transform: uppercase; }

  /* Areas */
  .areas {
    list-style: none;
    padding: 0;
    margin: 32px auto 32px;
    max-width: 960px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }
  .area {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 78px;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    font-weight: 600;
    color: var(--ink-strong);
    text-decoration: none;
  }
  a.area:hover { border-color: var(--maroon); color: var(--maroon); }
  .area.home { background: var(--maroon-mid); border-color: var(--maroon-mid); color: var(--white); }
  .area small { font-size: 11px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; margin-top: 4px; }

  /* Badges */
  .badges-band { background: var(--white); padding-block: 36px; border-bottom: 1px solid var(--line); }
  .badges {
    list-style: none;
    margin-block: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 28px 44px;
  }
  .badges :global(img) { height: 72px; width: auto; }

  /* Map */
