---
// Homepage, rebuilt from the live Duda page (edelroofing.com, 2026-10-18).
// Copy is the live copy. Changes: the license number and the hours line were
// broken on the live page (a phone-number find/replace hit them), em dashes
// swapped for commas/periods, McAllen + Mission area cards now link to their
// city pages, review counts use the live Google total (4.8, 257 on 2026-10-18),
// and the hero follows the mobile-first first-screen pattern (2026-10-18).
// Layout lives in HomeBody.astro (shared with /es-mx); copy in src/data/home.ts.
import Base from '../layouts/Base.astro';
import HomeBody from '../components/HomeBody.astro';
import { site } from '../data/site';
import { homeEn as copy } from '../data/home';

const strip = (html: string) => html.replace(/<[^>]+>/g, '');
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.legalName, url: 'https://www.edelroofing.com/' },
  // RoofingContractor block comes from Base (src/data/schema.ts).
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: copy.faq.items.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: strip(f.a) },
    })),
  },
];
---
<Base title={copy.title} description={copy.description} schema={schema} alternates={{ en: '/', es: '/es-mx' }}>
  <HomeBody copy={copy} />
</Base>
