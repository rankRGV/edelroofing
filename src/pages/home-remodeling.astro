---
// /home-remodeling, rebuilt from the live Duda page (2026-10-18).
// Open question: does Edel still sell remodeling? The page is off the live
// nav (2 inlinks). Rebuilt as is so the URL keeps working; not linked from
// the menu.
// Copy changes vs live:
// - Em dashes around "from fixtures to tiles" swapped for commas.
// - Headings "Elevate Your Bathroom" -> "Update Your Bathroom" and "Elevate
//   Your Living Spaces" -> "Refresh Your Living Spaces" (elevate as a
//   headline verb is banned).
// - Headings written in normal case (CSS uppercases them, same look).
// - Added: breadcrumb, trust strip, quote/call buttons.
import InnerPage from '../layouts/InnerPage.astro';
import hero from '../assets/home-remodeling/home-interior.webp';
import island from '../assets/home-remodeling/kitchen-island-interior-design.jpg';
import kitchen from '../assets/home-remodeling/newly-built-kitchen.jpg';
import bathroom from '../assets/home-remodeling/bathroom-remodeling.webp';
---
<InnerPage
  title="Home Remodeling Services | Edel Roofing & Construction Inc."
  description="Elevate your living spaces with our top-tier home remodeling services. We turn your dreams into reality, delivering unmatched quality from start to finish."
  alternates={{ en: '/home-remodeling', es: '/es-mx/home-remodeling' }}
  crumbs={[
    { label: 'Home', href: '/' },
    { label: 'Home Remodeling', href: '/home-remodeling' },
  ]}
  hero={{ eyebrow: 'Our Remodeling Services', title: 'Home Remodeling', bg: hero }}
  intro={{
    eyebrow: 'Bathroom and Kitchen Remodeling',
    title: 'Transform Your Space',
    body: "EDEL Roofing &amp; Construction invites you to reimagine your home's heart and soul with our <a href=\"/\">Bathroom and Kitchen Remodeling</a> services. Our expert team is dedicated to breathing new life into these essential spaces, creating functional yet stylish environments that reflect your unique taste and needs.",
    cta: { label: 'Contact Us', href: '/contact-us' },
    images: [{ src: island, alt: 'Kitchen Remodeling Service' }],
  }}
  band={{
    eyebrow: 'Kitchen Remodeling',
    title: 'Revitalize Your Kitchen',
    body: "The kitchen is where memories are made, and our Kitchen Remodeling service aims to enhance both its aesthetics and functionality. From modernizing the layout for better workflow to selecting high-quality materials that stand up to daily use, we approach kitchen remodels with precision and creativity. Let us create a space that's as inviting as it is practical.",
    cta: { label: 'Get Instant Quote', href: '/contact-us', roofle: true },
    images: [{ src: kitchen, alt: 'Newly Built Kitchen' }],
  }}
  extra={[
    {
      eyebrow: 'Bathroom Remodeling',
      title: 'Update Your Bathroom',
      body: "Our Bathroom Remodeling service encompasses a wide range of possibilities. We collaborate closely with you to understand your preferences, ensuring that every detail, from fixtures to tiles, aligns with your vision. Whether it's a simple update or a complete transformation, we're here to turn your bathroom dreams into reality.",
      cta: { label: 'Get Instant Quote', href: '/contact-us', roofle: true },
      images: [{ src: bathroom, alt: 'Bathroom Remodeling' }],
    },
  ]}
  benefits={{
    title: 'Key Benefits of Our Remodeling Services',
    items: [
      { title: 'Design Expertise', body: 'Our team of experienced designers is well-versed in translating your ideas into reality, ensuring your newly remodeled spaces align with your vision.' },
      { title: 'Quality Craftsmanship', body: 'Every aspect of our remodeling process is carried out with meticulous attention to detail, resulting in finished spaces that exceed expectations.' },
      { title: 'Tailored Solutions', body: 'We understand that every home is unique. Our solutions are customized to fit your lifestyle, needs, and aesthetic preferences.' },
    ],
  }}
  closing={{
    title: 'Refresh Your Living Spaces',
    body: 'Discover the power of change with EDEL Roofing &amp; Construction. Our Bathroom and Kitchen Remodeling services revitalize your spaces, enhancing their appeal and functionality. Reach out today to discuss your project and take the first step towards a home that embodies your style.',
    cta: { label: 'Contact Us', href: '/contact-us' },
  }}
/>
