---
// /financing, rebuilt from the live Duda page (2026-10-18).
// The live page is only the eyebrow and H1: no lender, terms, or form.
// Copy changes vs live:
// - Meta description promised "Apply online today and get a quick decision";
//   there is no online application, so it now says to call.
// - Added one plain section using the homepage FAQ's own wording ("We offer
//   financing options for roof replacement and repairs"), plus breadcrumb,
//   trust strip, quote/call buttons, closing call band.
// Open (Edel): lender name, terms, and whether there is an application link.
// Don't add rates, approvals, or "no credit" claims until Edel gives them.
import InnerPage from '../layouts/InnerPage.astro';
import hero from '../assets/home/truck-house.jpeg';
import { site } from '../data/site';
---
<InnerPage
  title="Financing | Home Construction and Roofing Company"
  description="Don't let cost stop you from getting a new roof. Edel Roofing offers financing options for roof replacement and repairs. Call (956) 422-3335 to ask."
  crumbs={[
    { label: 'Home', href: '/' },
    { label: 'Financing', href: '/financing' },
  ]}
  hero={{ eyebrow: 'Flexible Financing Options', title: 'For Your Roofing Project', bg: hero }}
  intro={{
    title: 'Ask About Financing',
    body: [
      'We offer financing options for roof replacement and repairs.',
      `Call <a href="${site.phoneHref}">${site.phone}</a> and ask about financing when we set up your free inspection. You get a written estimate before any work starts, so you know the amount you are financing.`,
    ],
    cta: { label: 'Get Instant Estimate', href: '/contact-us#estimate', roofle: true },
  }}
  closing={{
    title: 'Protect Your Home Today',
    body: 'Start with a free inspection and a written estimate from a licensed Edinburg roofer.',
    cta: { label: 'Contact Us', href: '/contact-us' },
  }}
/>
