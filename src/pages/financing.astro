---
// /financing, GoodLeap version (2026-11-25).
// Edel's lender is now GoodLeap (GoodLink email 11/24). GoodLeap's partner
// guide rules for this page:
// - Their approved paragraph word for word (the intro body below) and their
//   approved logo (src/assets/goodleap/). No loan claims of our own: no
//   rates, APR, terms, "no credit check" or "guaranteed approval".
// - One button to Edel's QuickLink (goodleap.quickLink in data/site.ts),
//   added only after GoodLeap approves the page.
// - noindex (keeps bots and fake applications out) and out of the sitemap
//   (EXCLUDE in scripts/sitemap-lastmod.mjs). Stays noindex after launch.
// - English only. /es-mx/financing stays the call-to-ask page, with no
//   GoodLeap copy.
// History: 2026-10-18 rebuilt from the live Duda page; 2026-11-09 rates kept
// off until confirmed as APR (still off: GoodLeap's form shows estimates).
import InnerPage from '../layouts/InnerPage.astro';
import hero from '../assets/home/truck-house.jpeg';
import { site, goodleap } from '../data/site';

// GoodLeap's approved logo, if it has been added (see the folder's README).
const logos = import.meta.glob<{ default: ImageMetadata }>('../assets/goodleap/*.{svg,png,jpg,jpeg,webp}', { eager: true });
const logo = Object.values(logos)[0]?.default;
const logoHtml = logo
  ? `<img src="${logo.src}" alt="GoodLeap" width="200" height="${Math.round((200 * logo.height) / logo.width)}" loading="lazy" style="display:block;height:auto;margin-bottom:8px" />`
  : '';

// GoodLeap's approved copy. Do not edit.
const approved =
  'We have partnered with GoodLeap to offer flexible payment options for your project. GoodLeap uses a soft credit check until funding and the highest score from all 3 bureaus to see if you qualify. It also takes just a few minutes to get started.';
---
<InnerPage
  title="Roof Financing | Edel Roofing & Construction"
  description="Flexible payment options for your roofing project through our partner GoodLeap. Start with a free roof inspection in Edinburg and the Rio Grande Valley."
  noindex={true}
  alternates={{ en: '/financing', es: '/es-mx/financing' }}
  crumbs={[
    { label: 'Home', href: '/' },
    { label: 'Financing', href: '/financing' },
  ]}
  hero={{
    eyebrow: 'Financing',
    title: 'Roof Financing',
    lead: 'Pay for your new roof or repair over time, with flexible payment options through our partner GoodLeap.',
    bg: hero,
  }}
  intro={{
    title: 'Financing with GoodLeap',
    body: [...(logoHtml ? [logoHtml] : []), approved],
    cta: { label: 'Get Started', href: goodleap.quickLink || '#financing' },
  }}
  benefits={{
    title: 'How it works',
    items: [
      { title: 'Free inspection', body: "A licensed Edel roofer checks your roof and gives you a written estimate before any work starts, so you know how much you'd be financing." },
      { title: 'Apply with GoodLeap', body: 'Click Get Started to see your options and apply.' },
      { title: 'We get to work', body: 'Once your financing is set, we schedule your project.' },
    ],
  }}
  closing={{
    title: 'Start with a free inspection',
    body: `Have questions about financing? Call <a href="${site.phoneHref}">${site.phone}</a> and ask when you set up your inspection.`,
    cta: { label: 'Schedule a Free Inspection', href: '/book-an-inspection' },
  }}
/>
