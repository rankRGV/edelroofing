---
// /residential-roofing, rebuilt from the live Duda page (2026-10-18).
// Copy changes vs live:
// - Em dash after "functional roof" swapped for a comma.
// - "seamlessly combines" -> "combines" (banned word).
// - "stands as a testament to exceptional craftsmanship" -> "shows real
//   craftsmanship" (banned word).
// - Heading "Elevate Your Property" -> "Protect and Improve Your Property"
//   (elevate as a headline verb is banned).
// - "ResidentialRoofing" (missing space, two links) -> one link.
// - Dropped the Duda slider placeholders ("Slide title", "Write your caption
//   here").
// - Added: links to the city roof replacement pages, breadcrumb, trust strip,
//   quote/call buttons.
// - 2026-10-20 copy pass: plain, warm rewrite; removed hype ("The Best",
//   "unmatched quality", "aesthetic elegance", "masterpiece", "shield",
//   "crowns your property", "stands the test of time"); removed unproven
//   claims ("significantly save on utility bills", "adding value"); added
//   sheet facts (brands, ShingleMaster, one to two days, free inspection).
import InnerPage from '../layouts/InnerPage.astro';
import hero from '../assets/residential-roofing/house-with-swimming-pool.jpg';
import construction from '../assets/residential-roofing/roofing-construction.jpeg';
import install from '../assets/residential-roofing/roof-installation-residential.jpeg';
import residential from '../assets/residential-roofing/residential-roofing.jpeg';
import newRoof from '../assets/residential-roofing/new-residential-roof.jpeg';
---
<InnerPage
  title="Residential Roofing in Edinburg, TX | Edel Roofing & Construction"
  description="New roofs and roof replacement for homes in Edinburg and the Rio Grande Valley. CertainTeed, Owens Corning and GAF. Free inspection and written estimate."
  alternates={{ en: '/residential-roofing', es: '/es-mx/residential-roofing' }}
  crumbs={[
    { label: 'Home', href: '/' },
    { label: 'Residential Roofing', href: '/residential-roofing' },
  ]}
  hero={{ eyebrow: 'Residential roofing', title: 'Residential Roofing in Edinburg, TX', bg: hero }}
  intro={{
    eyebrow: 'For homeowners',
    title: 'A new roof for your Edinburg home',
    body: "Maybe your roof is getting old, or the same spot keeps leaking after every storm. EDEL Roofing &amp; Construction Inc. puts new roofs on homes in Edinburg and across the Valley. Our <a href=\"/\">residential roofing services in Edinburg</a> start with a free inspection and a written price. We pick materials that hold up and look right on your house.",
    cta: { label: 'Contact Us', href: '/contact-us' },
    images: [{ src: construction, alt: 'Roofing Construction' }],
  }}
  band={{
    eyebrow: 'Roof installation',
    title: 'How your new roof goes on',
    body: "It starts with a free inspection and a written estimate, so you see the scope and the price before anything comes off. You choose the material and the color. We install CertainTeed, Owens Corning and GAF, among others, and we're the only CertainTeed Select ShingleMaster in the Rio Grande Valley. Most houses are done in one to two days. A bigger roof or a different material can take longer, and we'll tell you before we start.",
    cta: { label: 'Get Instant Estimate', href: '/contact-us#estimate', roofle: true },
    images: [
      { src: install, alt: 'Roof Installation Residential' },
      { src: residential, alt: 'Residential Roofing' },
      { src: newRoof, alt: 'New Residential Roof' },
    ],
  }}
  benefits={{
    title: 'What you get with Edel',
    items: [
      { title: 'Your choice of material', body: 'Asphalt shingles, metal roofing and other materials and styles. We work on homes and on commercial buildings.' },
      { title: 'Energy efficient options', body: 'Ask us about roofing options made for better energy efficiency. We can go over them with you at the inspection.' },
      { title: 'Good materials, careful work', body: 'We use quality materials and take care with the installation, so your new roof keeps working for years.' },
    ],
  }}
  spokes={{
    title: 'Roof Replacement by City',
    intro: 'Pick your city to read about roof replacement, roof inspections and gutters there.',
    links: [
      { href: '/roof-replacement-edinburg-tx', label: 'Roof Replacement in Edinburg, TX' },
      { href: '/roof-replacement-mcallen-tx', label: 'Roof Replacement in McAllen, TX' },
      { href: '/roof-replacement-mission-tx', label: 'Roof Replacement in Mission, TX' },
      { href: '/roof-inspections-mcallen-tx', label: 'Roof Inspections in McAllen, TX' },
      { href: '/roof-inspections-mission-tx', label: 'Roof Inspections in Mission, TX' },
      { href: '/gutters-edinburg-tx', label: 'Gutter Installation & Repair in Edinburg, TX' },
    ],
  }}
  closing={{
    title: 'Thinking about a new roof?',
    body: "Call us and we'll set up a free inspection. We'll tell you whether your roof can be repaired or needs to be replaced, and you'll get a written estimate either way.",
    cta: { label: 'Contact Us', href: '/contact-us' },
  }}
/>
