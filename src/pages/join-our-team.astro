---
// /join-our-team, rebuilt from the live Duda page (2026-10-18).
// Open (Edel): still hiring? Applications post to FormSpark (data/forms.ts),
// to eddie@ + kassie@edelroofing.com for now (Eddie, 2026-10-18); the live
// Duda recipient is encrypted in the page.
// Copy changes vs live:
// - No H1 on live; "Join Our Team" is now the H1.
// - Em dash in "isn't just recognized, it's celebrated" swapped for a comma.
// - Heading "Elevate Your Sales Career" -> "Grow Your Sales Career"
//   (elevate as a headline verb is banned).
// - "Embark on a journey steeped in legacy" -> "Start a career steeped in
//   legacy" (banned word).
// - "underscores our dedication" -> "shows our dedication" (banned word).
// - "Become part of a vibrant team where your dedication to excellence is not
//   just valued, but essential" -> "Become part of a team where your
//   dedication to excellence is valued and essential" (banned word/pattern).
// - The "(956) 422-EDEL / Call us today" link dialed (956) 867-0667; now the
//   real number.
// - Earnings ($80K to $120K), "BBB approved" and "Travel Opportunities"
//   kept as live (Edel's own claims; confirm before launch).
// - Added: breadcrumb, quote/call buttons.
// - 2026-10-20 copy pass: plain, warm rewrite; removed hype ("energize",
//   "elevate our standards", "outshine", "relishing every step of the
//   journey", "Exceptional customer feedback", "Instant rewards");
//   "25+ Years" stat -> "Since 2003"; "Top Reviews" now states the real
//   4.8 / 250+ Google rating; the story section no longer repeats
//   /about-us word for word; form heading "Contact Us" -> "Apply now".
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import LeadForm from '../components/LeadForm.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { breadcrumbSchema } from '../data/schema';
import { forms } from '../data/forms';
import hero from '../assets/join-our-team/edel-roofing-5.jpg';
import truck from '../assets/about-us/edel-truck.webp';
import building from '../assets/about-us/commercial-building.jpg';
import install from '../assets/about-us/roofing-install.jpeg';
import kitchen from '../assets/about-us/new-modern-kitchen.jpg';
import house from '../assets/about-us/modern-house.jpg';

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Join Our Team', href: '/join-our-team' },
];
const perks = [
  ['Earnings', '$80K to $120K a year.'],
  ['Reviews', 'Customers rate us 4.8 on Google, from 250+ reviews.'],
  ['Commissions', 'You earn commission on the contracts you close.'],
  ['Simple sales', 'You sell. We handle the logistics.'],
  ['Room to grow', 'Resources to help you move up.'],
  ['Accredited', 'BBB approved.'],
  ['Travel', 'Chances to travel for work.'],
];
const photos = [
  { src: truck, alt: "Edel Roofing & Construction Inc's Truck" },
  { src: building, alt: 'Commercial Building' },
  { src: install, alt: 'Roofing Install' },
  { src: kitchen, alt: 'New Modern Kitchen' },
  { src: house, alt: 'Home Remodeling' },
];
---
<Base
  title="Roofing Sales Jobs in McAllen & the RGV | Join EDEL Roofing"
  description="Sales jobs at EDEL Roofing & Construction in McAllen and the Rio Grande Valley. Earn $80K to $120K a year, with room to grow. Apply online."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Careers at Edel"
    title="Join Our Sales Team"
    lead="We're hiring salespeople in McAllen and across the Rio Grande Valley. If you like talking with homeowners and want your pay to grow with your effort, we'd like to meet you."
    bg={hero}
  />

  <section class="section">
    <div class="wrap split">
      <div>
        <p class="stat"><strong>Since 2003</strong>Roofing the Valley</p>
        <h2>What you get</h2>
        <ul class="perks">
          {perks.map(([title, body]) => (
            <li><Icon name="badge" /><span><strong>{title}:</strong> {body}</span></li>
          ))}
        </ul>
      </div>
      <div class="apply" id="ApplyNow">
        <h3>Apply now</h3>
        <LeadForm
          id="apply"
          submit="Send application"
          endpoint={forms.join}
          lead={false}
          fields={[
            { name: 'first_name', label: 'First Name', required: true, autocomplete: 'given-name' },
            { name: 'last_name', label: 'Last Name', required: true, autocomplete: 'family-name' },
            { name: 'email', label: 'Email', type: 'email', required: true, autocomplete: 'email' },
            { name: 'phone', label: 'Phone', type: 'tel', required: true, autocomplete: 'tel' },
            { name: 'address', label: 'Address', autocomplete: 'street-address' },
            { name: 'city', label: 'City', autocomplete: 'address-level2' },
            { name: 'zip', label: 'Zip Code', autocomplete: 'postal-code' },
          ]}
        />
      </div>
    </div>
  </section>

  <section class="section soft">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Why work here</p>
        <h2>Work for a Valley company</h2>
        <p>
          EDEL Roofing &amp; Construction has been roofing the Rio Grande Valley since 2003. Founder Eddie Elizondo
          built the company on quality work and good customer service, and people here know our name. Sales roles can
          earn $80K to $120K a year, with chances to move up and to travel.
        </p>
      </div>
      <div class="gallery">
        {photos.map((p, i) => (
          <Image src={p.src} alt={p.alt} widths={i === 0 ? [480, 760, 1100] : [240, 400]} sizes={i === 0 ? '(max-width: 900px) 100vw, 560px' : '(max-width: 900px) 25vw, 140px'} class:list={['rounded', { main: i === 0 }]} />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap narrow">
      <h2>About Eddie and the company</h2>
      <p>
        Eddie Elizondo has been around construction all his life. He worked with family first and continued his schooling
        before he founded EDEL Roofing &amp; Construction Inc. The company puts on roofs, remodels interiors
        and builds new homes.
      </p>
      <p>
        We've been named in the Readers' Choice Awards from The Monitor and from the Valley Morning Star. That comes
        from putting customers first and being honest with them about every project, and we expect the same from
        everyone on our team.
      </p>
    </div>
  </section>

  <CtaBand
    title="Ready to apply?"
    body="Fill out the form above and we'll get back to you. You'd be selling roofs for a licensed company based right here in the Valley."
    cta={{ label: 'Apply Now', href: '#ApplyNow' }}
  />
</Base>

<style>
  .section { padding-block: 80px; }
  .soft { background: var(--bg-soft); }
  .narrow { max-width: 860px; }
  h2 { font-size: clamp(30px, 4vw, 46px); text-transform: uppercase; }
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: start; }
  .stat { display: inline-flex; flex-direction: column; padding: 14px 20px; margin-bottom: 20px; border-left: 3px solid var(--maroon); background: var(--bg-soft); font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase; }
  .stat strong { font-family: var(--font-head); font-size: 34px; letter-spacing: 0; text-transform: none; color: var(--maroon); line-height: 1.1; }
  .perks { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .perks li { display: flex; gap: 12px; align-items: flex-start; }
  .perks :global(svg) { width: 22px; height: 22px; flex: none; color: var(--maroon); margin-top: 2px; }
  .apply { padding: 28px; background: var(--white); border: 1px solid var(--line); border-top: 3px solid var(--maroon); border-radius: 12px; box-shadow: 0 16px 40px rgba(0, 0, 0, 0.08); scroll-margin-top: 90px; }
  .apply h3 { font-size: 30px; }
  .gallery { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  .gallery :global(img) { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius); }
  .gallery :global(img.main) { grid-column: 1 / -1; aspect-ratio: 4 / 3; }
  @media (max-width: 900px) {
    .section { padding-block: 56px; }
    .split { grid-template-columns: 1fr; gap: 32px; }
  }
  @media (max-width: 600px) { .apply { padding: 20px; } }
</style>
