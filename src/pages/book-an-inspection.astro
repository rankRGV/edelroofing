---
// /book-an-inspection, rebuilt from the live Duda page (2026-10-18).
// The live page is only a Tavros (gotavros.com) booking iframe.
// 2026-11-10: calendar is back above the form (Eddie 11/3: Tavros stays;
// conversion audit found it still switched off).
// Copy changes vs live:
// - No H1 on live; "Book an Inspection" is now the H1.
// - Added: call + quote options, worded like the homepage quote card,
//   breadcrumb, trust strip, closing call band.
// - 2026-10-20 copy pass: plain, warm rewrite; H1 and title now say "Free
//   Roof Inspection"; meta description drops "expert team ensures quality
//   work & customer satisfaction"; added "We answer 24/7" (sheet fact).
// - 2026-10-21: the homepage's "Schedule a Free Inspection" buttons land
//   here (Edel's visual edit guide), so the page gets an inspection request
//   form (FormSpark `forms.inspection`, "please call" until the ID is set).
import InnerPage from '../layouts/InnerPage.astro';
import hero from '../assets/home/hero-roof.jpeg';
import { site } from '../data/site';
import { forms } from '../data/forms';
import LeadForm from '../components/LeadForm.astro';
import { TAVROS_URL } from '../data/site';
---
<InnerPage
  title="Book a Free Roof Inspection | Edel Roofing, Edinburg TX"
  description="Book a free roof inspection with Edel Roofing & Construction in Edinburg and the Rio Grande Valley. Call (956) 422-3335 or start with an online estimate."
  alternates={{ en: '/book-an-inspection', es: '/es-mx/book-an-inspection' }}
  crumbs={[
    { label: 'Home', href: '/' },
    { label: 'Book an Inspection', href: '/book-an-inspection' },
  ]}
  hero={{ eyebrow: 'Free roof inspections', title: 'Book a Free Roof Inspection', bg: hero }}
  intro={{
    title: 'Ways to get started',
    body: [
      '<strong>Pick a time.</strong> Use the calendar below, or fill out the form and we will call you to set up a time.',
      `<strong>Call us.</strong> Call <a href="${site.phoneHref}">${site.phone}</a> and we'll set up a time for your free roof inspection. We answer 24/7.`,
      '<strong>Want a price first?</strong> Put your address into the online estimate and find your roof on the satellite map. After you add your name, phone and email, it shows you an estimated price. We confirm the final price in writing after the free inspection.',
    ],
    cta: { label: 'Get Instant Estimate', href: '/contact-us#estimate', roofle: true },
  }}
  closing={{
    title: 'Not sure what your roof needs?',
    body: "That's what the inspection is for. We look the roof over, tell you what we see, and give you the scope and the price in writing before we begin.",
    cta: { label: 'Contact Us', href: '/contact-us' },
  }}
>
  <section class="section" id="calendar">
    <div class="wrap">
      <h2 class="center-h">Pick a Time</h2>
      <iframe class="tavros" title="Book an inspection" src={TAVROS_URL} loading="lazy"></iframe>
    </div>
  </section>
  <section class="section soft" id="schedule">
    <div class="wrap form-wrap">
      <h2 class="center-h">Rather we call you?</h2>
      <LeadForm
        id="inspection"
        submit="Schedule My Free Inspection"
        endpoint={forms.inspection}
        fields={[
          { name: 'name', label: 'Name', required: true, autocomplete: 'name' },
          { name: 'phone', label: 'Phone', type: 'tel', required: true, autocomplete: 'tel' },
          { name: 'email', label: 'Email', type: 'email', autocomplete: 'email' },
          { name: 'address', label: 'Property address', autocomplete: 'street-address' },
          { name: 'service', label: 'What do you need?', type: 'select', options: ['Roof Repair', 'Roof Replacement', 'Commercial Roofing', 'Storm Damage Inspection', 'Gutters', 'Not Sure'] },
          { name: 'message', label: 'Anything we should know?', type: 'textarea' },
        ]}
      />
    </div>
  </section>
</InnerPage>

<style>
  .section { padding-block: 72px; }
  .form-wrap { max-width: 720px; }
  .center-h { text-align: center; font-size: clamp(28px, 3.4vw, 40px); text-transform: uppercase; }
  .tavros { display: block; width: 100%; min-height: 800px; border: 0; }
</style>
