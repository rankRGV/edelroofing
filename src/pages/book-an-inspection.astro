---
// /book-an-inspection, rebuilt from the live Duda page (2026-10-18).
// The live page is only a Tavros (old agency, gotavros.com) booking iframe.
// It is LEFT OUT here until Eddie/Edel decide keep, replace, or drop, and
// confirm who receives those bookings. Flip TAVROS to true to bring it back.
// Copy changes vs live:
// - No H1 on live; "Book an Inspection" is now the H1.
// - Added: call + quote options, worded like the homepage quote card,
//   breadcrumb, trust strip, closing call band.
import InnerPage from '../layouts/InnerPage.astro';
import hero from '../assets/home/hero-roof.jpeg';
import { site } from '../data/site';

const TAVROS = false;
---
<InnerPage
  title="Book An Inspection"
  description="Schedule an inspection for roofing & remodeling services. Our expert team ensures quality work & customer satisfaction. Contact us today!"
  crumbs={[
    { label: 'Home', href: '/' },
    { label: 'Book an Inspection', href: '/book-an-inspection' },
  ]}
  hero={{ eyebrow: 'Free Roof Inspections', title: 'Book an Inspection', bg: hero }}
  intro={{
    title: 'Two Ways to Book',
    body: [
      `<strong>Call us.</strong> Call <a href="${site.phoneHref}">${site.phone}</a> and we set up your free roof inspection.`,
      '<strong>Want a price first?</strong> Enter your address in the online estimate and confirm your roof on the satellite map. It asks for your name, phone and email, then shows an estimated price. The final price comes in writing after the free inspection.',
    ],
    cta: { label: 'Get Instant Estimate', href: '/contact-us#estimate', roofle: true },
  }}
  closing={{
    title: 'Not Sure What Your Roof Needs?',
    body: 'Start with a free inspection and a written estimate. You know the scope and the price before we begin.',
    cta: { label: 'Contact Us', href: '/contact-us' },
  }}
>
  {TAVROS && (
    <section class="wrap">
      <iframe title="Book an inspection" src="https://tools.gotavros.com/widget/booking/xAmEhIorZ8LXCvdZIZU6" style="width:100%;min-height:800px;border:0"></iframe>
    </section>
  )}
</InnerPage>
