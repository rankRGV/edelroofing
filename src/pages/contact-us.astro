---
// /contact-us, rebuilt from the live Duda page (2026-10-18).
// The live page is the H1, three contact cards and the embedded Roofle
// quote (no Duda form). Copy changes vs live:
// - Address card linked a Google map of the old 3321 W Alberta Rd office
//   (the spam ProLine leads used that address); it now opens the GBP map
//   for 1815 N Jackson Rd.
// - Meta description said "Call now at 9568670667" (old number); now
//   (956) 422-3335.
// - Added: breadcrumb, trust strip, the homepage map embed, short section
//   labels, hreflang to /es-mx/contact-us.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ContactCards from '../components/ContactCards.astro';
import { breadcrumbSchema } from '../data/schema';
import { addressLine } from '../data/site';
import hero from '../assets/home/hero-roof.jpeg';

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Contact Us', href: '/contact-us' },
];
---
<Base
  title="Contact Us for Premium Roofing & Construction Services"
  description="Reach out to us for top-notch roofing, remodeling, and construction services in Rio Grande Valley. Our experts are ready to assist you. Call now at (956) 422-3335!"
  alternates={{ en: '/contact-us', es: '/es-mx/contact-us' }}
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero crumbs={crumbs} eyebrow="Get in Touch" title="Contact Edel Roofing Construction Inc." bg={hero} />
  <TrustStrip />

  <section class="section">
    <div class="wrap">
      <ContactCards />
    </div>
  </section>

  <section class="section soft" id="estimate">
    <div class="wrap">
      <h2 class="center">Instant Roof Quote</h2>
      <div class="roofle">
        <script is:inline async src="https://app.roofle.com/roof-quote-pro-embedded-widget.js?id=EDm90hQNG9UzNzk4GqU84"></script>
        <div id="roof-quote-pro-embedded"></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="center">Find Us in Edinburg</h2>
      <div class="map">
        <iframe
          title="Map to Edel Roofing & Construction in Edinburg, TX"
          src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d23667.384708486312!2d-98.2055292!3d26.2596735!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8665a146c4b26d97%3A0x676b08ea4b4d1f8c!2sEDEL%20Roofing%20and%20Construction%20Inc.!5e1!3m2!1sen!2sus!4v1747828235672!5m2!1sen!2sus"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen></iframe>
      </div>
      <p class="center small">{addressLine}</p>
    </div>
  </section>
</Base>

<style>
  .section { padding-block: 64px; }
  .soft { background: var(--bg-soft); }
  .center { text-align: center; }
  h2 { font-size: clamp(28px, 3.4vw, 40px); text-transform: uppercase; }
  .roofle { min-height: 645px; margin-top: 24px; background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .roofle :global(iframe) { display: block; width: 100%; min-height: 645px; border: 0; }
  .map { aspect-ratio: 16 / 7; margin-top: 24px; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); }
  .map iframe { width: 100%; height: 100%; border: 0; }
  .small { font-size: 14px; margin-top: 12px; }
  @media (max-width: 600px) {
    .section { padding-block: 44px; }
    .map { aspect-ratio: 4 / 3; }
  }
</style>
