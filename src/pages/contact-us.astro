---
// /contact-us, rebuilt from the live Duda page (2026-10-18).
// The live page is the H1, three contact cards and the embedded Roofle
// quote (no Duda form). Copy changes vs live:
// - Address card linked a Google map of the old 3321 W Alberta Rd office
//   (the spam ProLine leads used that address); it now opens the GBP map
//   for 1815 N Jackson Rd.
// - Meta description said "Call now at 9568670667" (old number); now
//   (956) 422-3335.
// - Added: breadcrumb, trust strip, the homepage map embed, short section
//   labels, hreflang to /es-mx/contact-us.
// - 2026-10-20 copy pass: plain, warm rewrite; title/description drop
//   "Premium", "top-notch" and "Our experts"; H1 gets its missing "&"; hero
//   lead added (24/7, se habla español, from the fact sheet).
// - 2026-10-23 (pre-launch audit): a message form under the Roofle embed,
//   same as the ES page, so the quote fallback never lands on Roofle alone;
//   the map pin moved off the old Alberta Rd office.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ContactCards from '../components/ContactCards.astro';
import LeadForm from '../components/LeadForm.astro';
import { breadcrumbSchema } from '../data/schema';
import { site, addressLine, mapEmbed } from '../data/site';
import { forms } from '../data/forms';
import hero from '../assets/home/hero-roof.jpeg';

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Contact Us', href: '/contact-us' },
];
---
<Base
  title="Contact Edel Roofing & Construction | Edinburg, TX Roofer"
  description="Call (956) 422-3335 or visit 1815 N Jackson Rd in Edinburg. Roofing, remodeling and construction across the Rio Grande Valley. Se habla español."
  alternates={{ en: '/contact-us', es: '/es-mx/contact-us' }}
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Contact us"
    title="Contact Edel Roofing & Construction"
    lead="Call, email, or stop by our office in Edinburg. We answer 24/7, and se habla español."
    bg={hero}
  />
  <TrustStrip />

  <section class="section">
    <div class="wrap">
      <ContactCards />
    </div>
  </section>

  <section class="section soft" id="estimate">
    <div class="wrap">
      <h2 class="center">Instant roof estimate</h2>
      <p class="center est-note">Enter your address and pick out your roof on the satellite map. Once you add your name, phone and email, you'll see an estimated price. Your final price comes in writing after we do a free inspection.</p>
      <div class="roofle">
        <script is:inline async src="https://app.roofle.com/roof-quote-pro-embedded-widget.js?id=EDm90hQNG9UzNzk4GqU84"></script>
        <div id="roof-quote-pro-embedded"></div>
      </div>
    </div>
  </section>

  <section class="section" id="message">
    <div class="wrap narrow">
      <h2 class="center">Send us a message</h2>
      <p class="center est-note">Tell us what you need and we'll call you back. Is it urgent? Call <a href={site.phoneHref}>{site.phone}</a>, we answer 24/7.</p>
      <LeadForm
        id="contact"
        submit="Send"
        endpoint={forms.inspection}
        fields={[
          { name: 'name', label: 'Name', required: true, autocomplete: 'name' },
          { name: 'phone', label: 'Phone', type: 'tel', required: true, autocomplete: 'tel' },
          { name: 'email', label: 'Email', type: 'email', autocomplete: 'email' },
          { name: 'address', label: 'Property address', autocomplete: 'street-address' },
          { name: 'message', label: 'Message', type: 'textarea' },
        ]}
      />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="center">Our office in Edinburg</h2>
      <div class="map">
        <iframe
          title="Map to Edel Roofing & Construction in Edinburg, TX"
          src={mapEmbed}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen></iframe>
      </div>
      <p class="center small">{addressLine}</p>
    </div>
  </section>
</Base>

<style>
  .section { padding-block: 64px; }
  .soft { background: var(--bg-soft); }
  .narrow { max-width: 760px; }
  .narrow .est-note { margin-bottom: 24px; }
  .center { text-align: center; }
  .est-note { max-width: 62ch; margin: 12px auto 0; }
  h2 { font-size: clamp(28px, 3.4vw, 40px); text-transform: uppercase; }
  .roofle { min-height: 645px; margin-top: 24px; background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .roofle :global(iframe) { display: block; width: 100%; min-height: 645px; border: 0; }
  .map { aspect-ratio: 16 / 7; margin-top: 24px; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); }
  .map iframe { width: 100%; height: 100%; border: 0; }
  .small { font-size: 14px; margin-top: 12px; }
  @media (max-width: 600px) {
    .section { padding-block: 44px; }
    .map { aspect-ratio: 4 / 3; }
  }
</style>
