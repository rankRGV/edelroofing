---
<Base
  title="Our Projects | Home Construction and Roofing Company"
  description="Check Out our exceptional construction and roofing company projects showcasing quality craftsmanship and innovative solutions. Elevate your space with us now!"
  alternates={{ en: '/projects', es: '/es-mx/projects' }}
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero crumbs={crumbs} eyebrow="Gallery" title="Our Roofing Projects" bg={hero} />
  <TrustStrip />

  <ProjectGallery photos={order} />

  <CtaBand
    title="We've Got You Covered"
    body="Ready to start your roofing, remodeling, or construction journey? Contact Eddie Elizondo and the EDEL team today. Let's turn your dreams into reality."
    cta={{ label: 'Contact Us', href: '/contact-us' }}
  />
</Base>
