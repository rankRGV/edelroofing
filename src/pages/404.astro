---
// Branded 404 (2026-10-18). Vercel served its plain white "404: NOT_FOUND"
// page before, which loses anyone who follows an old Duda or Google link.
// Same hero as the inner pages (quote + call), then the main pages.
// 2026-10-20 copy pass: plain, warm rewrite of the lead.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SpokeLinks from '../components/SpokeLinks.astro';
import hero from '../assets/home/hero-roof.jpeg';

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Page not found', href: '/404' },
];
const links = [
  { href: '/roof-repairs', label: 'Roof Repairs' },
  { href: '/residential-roofing', label: 'Residential Roofing' },
  { href: '/commercial-roofing', label: 'Commercial Roofing' },
  { href: '/storm-damage', label: 'Storm Damage' },
  { href: '/service-areas', label: 'Service Areas' },
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Blog' },
  { href: '/contact-us', label: 'Contact Us' },
  { href: '/es-mx', label: 'Español: Página principal' },
];
---
<Base title="Page Not Found | Edel Roofing & Construction" noindex>
  <PageHero
    crumbs={crumbs}
    title="We can't find that page"
    lead="The link may be old or have a typo. Pick a page below, or give us a call and we'll help you find what you need."
    bg={hero}
  />
  <SpokeLinks title="Popular pages" links={links} />
</Base>
