---
// /commercial-roofing, rebuilt from the live Duda page (2026-10-18).
// Copy changes vs live:
// - Title typo "Commercial Roofing  Servies" -> "Commercial Roofing Services".
// - H1 "Commercial ROOFING" -> "Commercial Roofing" (CSS uppercases it).
// - Grammar: "At EDEL ..., the go-to roofing company in Edinburg bring" ->
//   "EDEL ..., the go-to roofing company in Edinburg, brings".
// - Dropped the Duda slider placeholders ("Slide title", "Write your caption
//   here").
// - Added: links to the city commercial roofing and roof coating pages,
//   breadcrumb, trust strip, quote/call buttons.
// - 2026-10-20 copy pass: plain, warm rewrite; removed hype ("top-notch",
//   "unwavering", "highest standard", "tackle any commercial roofing
//   challenge"); "since 2003" replaces "over two decades" and "25-year
//   legacy"; H1 and title now carry Edinburg and the RGV.
import InnerPage from '../layouts/InnerPage.astro';
import hero from '../assets/commercial-roofing/roofing-construction.jpeg';
import building from '../assets/commercial-roofing/commercial-building.jpg';
import commercial from '../assets/commercial-roofing/commercial-roofing.jpeg';
import repair from '../assets/commercial-roofing/commercial-roofing-repair.jpeg';
import repairing from '../assets/commercial-roofing/repairing-commercial-roof.jpeg';
import { site } from '../data/site';

// 2026-10-21: Dustin (commercial) asked for the commercial certs instead of
// the residential ones; list matches his certification sheet.
const certs = [
  `Texas licensed roofing contractor (${site.license})`,
  'Versico Authorized Contractor',
  'Polyglass Registered Contractor',
  'KARNAK',
  'Duro-Last',
  'GAF',
  'Owens Corning Preferred Contractor',
];
---
<InnerPage
  title="Commercial Roofing in Edinburg & the RGV | EDEL Roofing"
  description="Commercial roof installation, repair and replacement in Edinburg and the Rio Grande Valley. Low sloped and pitched roofs: TPO, modified, EPDM, PVC, shingles, tile and metal."
  trustCert="Versico Authorized and Polyglass Registered Contractor"
  alternates={{ en: '/commercial-roofing', es: '/es-mx/commercial-roofing' }}
  crumbs={[
    { label: 'Home', href: '/' },
    { label: 'Commercial Roofing', href: '/commercial-roofing' },
  ]}
  hero={{ eyebrow: 'For business owners', title: 'Commercial Roofing in Edinburg and the RGV', bg: hero }}
  intro={{
    eyebrow: 'Commercial roofing',
    title: 'Roofs for Valley businesses',
    body: 'A leak over your shop floor, office or warehouse is a problem you need fixed fast, and the roof protects everything under it. EDEL Roofing &amp; Construction Inc. is a <a href="/">roofing company in Edinburg</a> that has done commercial roofing since 2003. We install new commercial roofs and handle repairs, maintenance and replacement for businesses across the Rio Grande Valley.',
    cta: { label: 'Contact Us', href: '/contact-us' },
    images: [{ src: building, alt: 'Commercial Roofing' }],
  }}
  band={{
    eyebrow: 'Commercial roof installation',
    title: 'How we handle a commercial job',
    body: 'Eddie Elizondo started this company on good work and good customer service, and we run commercial jobs the same way. Our crews are experienced, and we use quality materials so your roof keeps doing its job for years. Before any work starts, you get a written estimate with the scope and the price.',
    cta: { label: 'Get Instant Estimate', href: '/contact-us#estimate', roofle: true },
    images: [
      { src: commercial, alt: 'Commercial Roofing' },
      { src: repair, alt: 'Commercial Roofing Repair' },
      { src: repairing, alt: 'Commercial Roof Installation' },
    ],
  }}
  benefits={{
    title: 'What we offer businesses',
    items: [
      { title: 'Low sloped and pitched roofs', body: 'A commercial building can have any kind of roof: TPO, modified bitumen, EPDM, PVC, shingles, tile or metal. We work on all of them, from new installs to <a href="/roof-repairs">roof repairs</a>, maintenance and replacement.' },
      { title: 'Buildings of all sizes', body: 'Our crews are skilled at commercial roofing and work on buildings of every size, whether the job is simple or complicated.' },
      { title: 'Quality materials', body: 'We buy from suppliers we trust and use quality roofing materials made to last on a commercial roof.' },
    ],
  }}
  spokes={{
    title: 'Commercial Roofing by City',
    intro: 'Is your building in Edinburg, McAllen or Mission? Each page below covers commercial roofing or roof coatings in that city.',
    links: [
      { href: '/commercial-roofing-edinburg', label: 'Commercial Roofing in Edinburg, TX' },
      { href: '/commercial-roofing-mcallen-tx', label: 'Commercial Roofing in McAllen, TX' },
      { href: '/commercial-roofing-mission-tx', label: 'Commercial Roofing in Mission, TX' },
      { href: '/roof-coatings-mcallen-tx', label: 'Roof Coating Services in McAllen, TX' },
      { href: '/roof-coating-mission-tx', label: 'Roof Coating Services in Mission, TX' },
    ],
  }}
  closing={{
    title: 'Need work on a commercial roof?',
    body: 'Tell us what is going on with your building, whether it needs commercial <a href="/roof-repairs">roofing repair</a> or a new roof. We work in Edinburg, TX and all over the Rio Grande Valley, and the consultation and estimate are free.',
    cta: { label: 'Contact Us', href: '/contact-us' },
  }}
>
  <section class="certs">
    <div class="wrap">
      <h2>Commercial license and certifications</h2>
      <ul>
        {certs.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </section>
</InnerPage>

<style>
  .certs { padding-block: 72px; text-align: center; }
  .certs h2 { font-size: clamp(28px, 3.5vw, 42px); text-transform: uppercase; }
  .certs ul { list-style: none; margin: 28px auto 0; padding: 0; max-width: 960px; display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  .certs li { padding: 12px 18px; background: var(--white); border: 1px solid var(--line); border-top: 3px solid var(--maroon); border-radius: var(--radius); font-weight: 600; color: var(--ink); }
  @media (max-width: 900px) { .certs { padding-block: 56px; } }
</style>
