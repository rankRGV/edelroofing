---
// /about-us, rebuilt from the live Duda page (2026-10-18).
// Copy changes vs live:
// - "underscores our dedication" -> "shows our dedication" (banned word).
// - "to embark on your journey of turning possibilities into reality" ->
//   "to start turning possibilities into reality" (banned phrase).
// - The live "(956) 422-EDEL / Call us today" link dialed (956) 867-0667;
//   it now dials the real number from site.ts.
// - "Get Instant Estimate" pointed at /#estimate (no such anchor); it now opens
//   the Roofle quote.
// - Added: breadcrumb, trust strip, quote/call buttons.
// - 2026-10-20 copy pass: plain, warm rewrite; removed hype ("top-notch",
//   "exceptional", "dreams", "Partner in Transformation"); "since 2003"
//   replaces "25-year legacy"; "Reader's Choice" spelled "Readers' Choice".
import InnerPage from '../layouts/InnerPage.astro';
import hero from '../assets/inner/edel-roofing-banner.webp';
import truck from '../assets/about-us/edel-truck.webp';
import building from '../assets/about-us/commercial-building.jpg';
import install from '../assets/about-us/roofing-install.jpeg';
import kitchen from '../assets/about-us/new-modern-kitchen.jpg';
import house from '../assets/about-us/modern-house.jpg';
---
<InnerPage
  title="About EDEL Roofing & Construction | Edinburg, TX Since 2003"
  description="EDEL Roofing & Construction Inc. has been roofing the Rio Grande Valley since 2003. We also remodel and build homes. Meet founder Eddie Elizondo."
  alternates={{ en: '/about-us', es: '/es-mx/about-us' }}
  crumbs={[
    { label: 'Home', href: '/' },
    { label: 'About Us', href: '/about-us' },
  ]}
  hero={{ eyebrow: 'About us', title: 'About Edel Roofing & Construction Inc', bg: hero }}
  intro={{
    eyebrow: 'Who we are',
    title: 'Started by Eddie Elizondo, based in Edinburg',
    body: "EDEL Roofing &amp; Construction Inc. was founded by Eddie Elizondo, and we've been roofing homes and businesses in the Rio Grande Valley since 2003. We do <a href=\"/roof-repairs\">roofing repairs</a>, new roofs and full replacements. We also remodel kitchens and bathrooms and build new homes. Our office is at 1815 N Jackson Rd in Edinburg.",
    cta: { label: 'Contact Us', href: '/contact-us' },
    images: [
      { src: truck, alt: "Edel Roofing & Construction Inc's Truck" },
      { src: building, alt: 'Commercial Building' },
      { src: install, alt: 'Roofing Install' },
      { src: kitchen, alt: 'New Modern Kitchen' },
      { src: house, alt: 'Home Remodeling' },
    ],
  }}
  band={{
    title: 'How Edel got started',
    body: [
      "Eddie grew up around construction. He worked alongside family members, kept going with his education, and then opened EDEL Roofing &amp; Construction Inc. Today we put on roofs, remodel interiors and build homes from the ground up. The goal is the same one Eddie started with: give people the home they had in mind.",
      "People in the Valley know us for putting customers first and being honest and open about every job. Readers of The Monitor and the Valley Morning Star have both named us in their Readers' Choice Awards.",
    ],
  }}
  closing={{
    title: 'Talk with Eddie and the team',
    body: "Need a roof repair, a new roof, a remodel or a new home? Call Eddie Elizondo and the EDEL team and tell us what you need. For roofs, we start with a free inspection and give you a written estimate before any work begins.",
    cta: { label: 'Get Instant Estimate', href: '/contact-us#estimate', roofle: true },
  }}
/>
