---
// Small inline icon set (stroke icons follow Lucide's 24px grid).
interface Props { name: keyof typeof icons; class?: string }
const icons = {
  facebook: { fill: true, d: 'M14 8h3V4h-3c-2.8 0-4 1.8-4 4.3V11H7v4h3v9h4v-9h3l1-4h-4V8.6c0-.4.3-.6.6-.6Z' },
  google: { fill: true, d: 'M21.6 10.2H12v3.9h5.5c-.5 2.5-2.6 4-5.5 4a6.1 6.1 0 1 1 3.9-10.8l2.9-2.8A10.1 10.1 0 1 0 12 22c5.8 0 9.8-4.1 9.8-9.9 0-.7 0-1.3-.2-1.9Z' },
  pin: { d: 'M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Z M12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z' },
  mail: { d: 'M3 6h18v12H3z M3 7l9 6 9-6' },
  phone: { d: 'M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2Z' },
  chevron: { d: 'm6 9 6 6 6-6' },
  menu: { d: 'M4 6h16 M4 12h16 M4 18h16' },
  plus: { d: 'M12 5v14 M5 12h14' },
  roof: { d: 'M2 13 12 4l10 9 M5 11v8h14v-8' },
  users: { d: 'M16 20v-1a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v1 M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z M22 20v-1a4 4 0 0 0-3-3.9 M16 3.1a4 4 0 0 1 0 7.8' },
  shield: { d: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z M9 12l2 2 4-4' },
  badge: { d: 'M12 15a6 6 0 1 0 0-12 6 6 0 0 0 0 12Z M8.2 13.9 7 22l5-3 5 3-1.2-8.1' },
  star: { fill: true, d: 'm12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1Z' },
  clipboard: { d: 'M9 3h6v3H9z M7 5H5v16h14V5h-2 M9 12h6 M9 16h4' },
  arrow: { d: 'M5 12h14 M13 6l6 6-6 6' },
} as const;
const { name, class: cls } = Astro.props;
const icon = icons[name] as { d: string; fill?: boolean };
---
<svg
  class={cls}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  aria-hidden="true"
  fill={icon.fill ? 'currentColor' : 'none'}
  stroke={icon.fill ? 'none' : 'currentColor'}
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
><path d={icon.d} /></svg>
