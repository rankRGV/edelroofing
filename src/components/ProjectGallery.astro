---
// Project photo grid + tap-to-enlarge viewer, shared by /projects and
// /es-mx/projects. `photos` is [file in src/assets/projects, alt] in page order.
import { Image, getImage } from 'astro:assets';

interface Props { photos: [string, string][]; lang?: 'en' | 'es' }
const { photos: order, lang = 'en' } = Astro.props;
const t = lang === 'es'
  ? { dialog: 'Foto del proyecto', close: 'Cerrar', prev: 'Foto anterior', next: 'Foto siguiente' }
  : { dialog: 'Project photo', close: 'Close', prev: 'Previous photo', next: 'Next photo' };
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/projects/*', { eager: true });
const photos = await Promise.all(
  order.map(async ([file, alt]) => {
    const src = files[`../assets/projects/${file}`]?.default;
    if (!src) throw new Error(`missing project photo ${file}`);
    const big = await getImage({ src, width: 1280, format: 'webp', quality: 70 });
    return { src, alt, big: big.src };
  }),
);
---
  <section class="section">
    <ul class="wrap grid">
      {photos.map((p, i) => (
        <li>
          <a href={p.big} data-viewer={i}>
            <Image src={p.src} alt={p.alt} widths={[320, 480, 640]} sizes="(max-width: 600px) 50vw, (max-width: 1100px) 33vw, 300px" />
          </a>
        </li>
      ))}
    </ul>
  </section>

  <dialog class="viewer" aria-label={t.dialog}>
    <img alt="" />
    <button class="close" type="button" aria-label={t.close}>&times;</button>
    <button class="prev" type="button" aria-label={t.prev}>&lsaquo;</button>
    <button class="next" type="button" aria-label={t.next}>&rsaquo;</button>
  </dialog>

<script>
  // Tap a photo to see it large; arrows/keys move through the gallery.
  // Without JS the link opens the large image.
  const dialog = document.querySelector<HTMLDialogElement>('.viewer')!;
  const img = dialog.querySelector('img')!;
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-viewer]')];
  let current = 0;
  const show = (i: number) => {
    current = (i + links.length) % links.length;
    img.src = links[current].href;
    img.alt = links[current].querySelector('img')?.alt ?? '';
  };
  links.forEach((a, i) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      show(i);
      dialog.showModal();
    }),
  );
  dialog.querySelector('.close')!.addEventListener('click', () => dialog.close());
  dialog.querySelector('.prev')!.addEventListener('click', () => show(current - 1));
  dialog.querySelector('.next')!.addEventListener('click', () => show(current + 1));
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });
</script>

<style>
  .section { padding-block: 64px 88px; }
  .grid {
    list-style: none;
    margin-block: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }
  .grid a { display: block; overflow: hidden; border-radius: var(--radius); }
  .grid :global(img) { width: 100%; aspect-ratio: 1; object-fit: cover; transition: transform 0.25s ease; }
  .grid a:hover :global(img) { transform: scale(1.04); }
  .viewer {
    padding: 0;
    border: 0;
    background: transparent;
    max-width: min(1200px, 94vw);
    max-height: 92vh;
    overflow: visible;
  }
  .viewer::backdrop { background: rgba(20, 0, 0, 0.88); }
  .viewer img { max-width: 100%; max-height: 88vh; border-radius: var(--radius); margin: 0 auto; }
  .viewer button {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 50%;
    background: var(--white);
    color: var(--maroon);
    font-size: 32px;
    line-height: 1;
    cursor: pointer;
  }
  .close { top: -18px; right: -18px; }
  .prev, .next { top: 50%; transform: translateY(-50%); }
  .prev { left: -24px; }
  .next { right: -24px; }
  @media (max-width: 1100px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 600px) {
    .section { padding-block: 40px 56px; }
    .grid { grid-template-columns: repeat(2, 1fr); gap: 8px; }
    .close { top: 8px; right: 8px; }
    .prev { left: 8px; }
    .next { right: 8px; }
  }
</style>
