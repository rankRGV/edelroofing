---
import { Image } from 'astro:assets';
import logo from '../assets/edel-logo-white.png';
import { site, addressLine } from '../data/site';
import Icon from './Icon.astro';

interface Props { lang?: 'en' | 'es'; switchHref?: string }
const { lang = 'en', switchHref } = Astro.props;
const es = lang === 'es';
const year = new Date().getFullYear();
// Spanish wording follows the live /es-mx footer.
// 2026-10-20 copy pass: the "from top to bottom" tagline (EN + ES) is now a
// plain line with "since 2003" and the Edinburg office.
const t = es
  ? {
      home: '/es-mx',
      tagline: 'Techos para casas y negocios del Valle desde 2003. También remodelamos y construimos casas. Nuestra oficina está en Edinburg, TX.',
      quick: 'Enlaces Rápidos',
      quickLinks: [['/es-mx', 'Inicio'], ['/es-mx/about-us', 'Sobre Nosotros'], ['/es-mx/projects', 'Proyectos'], ['/es-mx/contact-us', 'Contáctenos']],
      services: 'Nuestros Servicios',
      serviceLinks: [['/es-mx/commercial-roofing', 'Techos Comerciales'], ['/es-mx/residential-roofing', 'Techos Residenciales'], ['/es-mx/roof-repairs', 'Reparaciones de Techos'], ['/es-mx/storm-damage', 'Daño de la Tormenta'], ['/es-mx/home-remodeling', 'Remodelación del Hogar'], ['/es-mx/home-construction', 'Construcción de Viviendas']],
      contact: 'Información del Contacto',
      address: 'Dirección', phone: 'Teléfono', email: 'Correo Electrónico',
      rights: 'Todos los derechos reservados', privacy: 'Política de Privacidad',
    }
  : {
      home: '/',
      tagline: 'Roofs for Valley homes and businesses since 2003. We also remodel and build homes. Our office is in Edinburg, TX.',
      quick: 'Quick Links',
      quickLinks: [['/', 'Home'], ['/about-us', 'About Us'], ['/projects', 'Projects'], ['/contact-us', 'Contact Us']],
      services: 'Our Services',
      serviceLinks: [['/commercial-roofing', 'Commercial Roofing'], ['/residential-roofing', 'Residential Roofing'], ['/roof-repairs', 'Roof Repairs'], ['/storm-damage', 'Storm Damage']],
      contact: 'Contact Information',
      address: 'Address', phone: 'Phone', email: 'Email',
      rights: 'All Rights Reserved', privacy: 'Privacy Policy',
    };
---
<footer class="site-footer">
  <div class="wrap grid">
    <div class="brand">
      <a href={t.home} aria-label="Edel Roofing & Construction">
        <Image src={logo} alt="Edel Roofing & Construction Inc" width={180} />
      </a>
      <p set:html={t.tagline} />
      <div class="social">
        <a href={site.facebook} aria-label="Facebook" rel="noopener" target="_blank"><Icon name="facebook" /></a>
        <a href={site.googleMaps} aria-label="Google" rel="noopener" target="_blank"><Icon name="google" /></a>
      </div>
    </div>

    <div>
      <h2>{t.quick}</h2>
      <ul>{t.quickLinks.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
    </div>

    <div>
      <h2>{t.services}</h2>
      <ul>{t.serviceLinks.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
    </div>

    <div class="contact">
      <h2>{t.contact}</h2>
      <p class="label">{t.address}</p>
      <p>{addressLine}</p>
      <p class="label">{t.phone}</p>
      <p><a href={site.phoneHref}>{site.phone}</a></p>
      <p class="label">{t.email}</p>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
  </div>

  <div class="wrap bottom">
    <p>&copy; {year} {t.rights} | EDEL ROOFING &amp; CONSTRUCTION INC</p>
    <div class="bottom-links">
      <a href={switchHref ?? (es ? '/' : '/es-mx')} hreflang={es ? 'en' : 'es'} lang={es ? 'en' : 'es'}>{es ? 'English' : 'Español'}</a>
      <a href="/privacy">{t.privacy}</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    /* Darker than the maroon closing bands so the page end is visible. */
    background: var(--maroon-dark);
    color: rgba(255, 255, 255, 0.88);
    padding-top: 56px;
    font-size: 14px;
  }
  .grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.4fr;
    gap: 32px;
  }
  h2 {
    font-size: 20px;
    color: var(--white);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 14px;
  }
  ul { list-style: none; margin: 0; padding: 0; }
  li { margin-bottom: 10px; }
  a { text-decoration: none; }
  a:hover { color: var(--white); text-decoration: underline; }
  .brand p { margin-top: 16px; max-width: 30ch; }
  .social { display: flex; gap: 10px; }
  .social a {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--white);
    color: var(--maroon);
  }
  .social :global(svg) { width: 16px; height: 16px; }
  .contact p { margin: 0 0 4px; }
  .contact .label {
    margin-top: 12px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--white);
  }
  .bottom {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 40px;
    padding-block: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    font-size: 13px;
  }
  .bottom p { margin: 0; }
  .bottom a { text-transform: uppercase; }
  .bottom-links { display: flex; gap: 20px; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .grid { grid-template-columns: 1fr; }
    /* Links were 18px tall; give thumbs a 40px row. */
    li { margin-bottom: 0; }
    ul a, .bottom-links a, .contact a { display: inline-block; padding-block: 10px; }
    .bottom-links { gap: 28px; }
  }
</style>
