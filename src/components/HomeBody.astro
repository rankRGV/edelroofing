---
// Homepage body, shared by / (EN) and /es-mx (ES); copy comes from
// src/data/home.ts. Section order reworked 2026-10-20 after the cold-visitor
// review (see the note at the top of home.ts). Reviews come from
// GoogleReviews.astro (our own section, no EmbedSocial widget). The diamond
// project collage above the estimate card was removed so the card lines up
// with the headline (Eddie, 2026-10-20).
// 2026-10-21: reworked to Edel's visual edit guide (see home.ts): schedule
// button first in the hero, five service cards, reviews and "Why Edel" as
// two sections, four steps plus a financing panel, new closing invitation.
import { Image } from 'astro:assets';
import { bgStyle } from '../data/bg';
import LeadForm from './LeadForm.astro';
import type { HomeCopy } from '../data/home';
import Icon from './Icon.astro';
import GoogleReviews from './GoogleReviews.astro';
import { site, addressLine, quoteFallback, mapEmbed } from '../data/site';
import { forms } from '../data/forms';


import heroRoof from '../assets/home/hero-roof.jpeg';
import truckHouse from '../assets/home/truck-house.jpeg';
import residential from '../assets/projects/recent/edel-residential-roof-remodel.jpg';
import commercial from '../assets/projects/recent/edel-trb-mcallen-commercial-roof.jpg';
import repairs from '../assets/home/repairs.jpg';
import storm from '../assets/storm-damage/edel-roofing-storm-damage-2.jpg';
// Stand-in until Kassie sends a real gutter photo (asked 2026-10-21).
import gutters from '../assets/projects/house-roof.webp';
import ctaBg from '../assets/home/cta-background.webp';
import certainteed from '../assets/badges/certainteed-select-shinglemaster.png';
import owensCorning from '../assets/badges/owens-corning-preferred.webp';
import rcat from '../assets/badges/rcat.webp';
import nrca from '../assets/badges/nrca.webp';
import bbb from '../assets/badges/bbb.webp';
import readers2019 from '../assets/badges/readers-choice-2019.jpg';
import readers2018 from '../assets/badges/readers-choice-2018.jpg';

interface Props { copy: HomeCopy }
const { copy: c } = Astro.props;

const heroBg = await bgStyle(heroRoof, 'hero');
const truckBg = await bgStyle(truckHouse, 'band');
const ctaBgSrc = await bgStyle(ctaBg, 'band');

const serviceImgs = [repairs, residential, commercial, storm, gutters];
const whyIcons = ['clipboard', 'badge', 'users'] as const;

const areas: { name: string; href?: string; home?: boolean }[] = [
  { name: 'Edinburg', href: c.areas.links.Edinburg, home: true },
  { name: 'McAllen', href: c.areas.links.McAllen },
  { name: 'Mission', href: c.areas.links.Mission },
  { name: 'Pharr' },
  { name: 'Weslaco' },
  { name: 'Harlingen' },
  { name: 'Brownsville' },
  { name: 'Rio Grande City' },
];

// Badges with a visible text label, so they read on a phone. The Google
// "5 Star" badge is left off: the live Google average is 4.8.
const es = c.lang === 'es';
const badges = [
  { src: certainteed, label: 'CertainTeed Select ShingleMaster' },
  { src: owensCorning, label: es ? 'Contratista Preferido de Owens Corning' : 'Owens Corning Preferred Contractor' },
  { src: rcat, label: 'Roofing Contractors Association of Texas' },
  { src: nrca, label: 'National Roofing Contractors Association' },
  { src: bbb, label: 'BBB' },
  { src: readers2019, label: es ? "Premio Readers' Choice 2019" : "Readers' Choice Award 2019" },
  { src: readers2018, label: es ? "Premio Readers' Choice 2018" : "Readers' Choice Award 2018" },
];

---
  {/* Hero: rating, H1, two reassurances, two sentences, estimate box. */}
  <section class="hero" style={heroBg}>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <a class="rating" href={site.googleMaps} rel="noopener" target="_blank">
          <span class="stars" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Icon name="star" />)}</span>
          <span set:html={c.rating} />
        </a>
        <h1>{c.h1}</h1>
        <p class="promise">{c.promise}</p>
        <ul class="assure">
          <li><Icon name="clipboard" /><Fragment set:html={c.assure[0]} /></li>
          <li><Icon name="badge" />{c.assure[1]}</li>
        </ul>
        <p class="hero-text" set:html={c.heroText} />
      </div>

      <div class="hero-side">
        <div class="quote-card">
          <p class="pill"><span class="dot"></span>{c.quote.pill}</p>
          <h2>{c.quote.title}</h2>
          <p>{c.quote.body}</p>
          <a class="btn btn--big" href={c.quote.schedule.href}>{c.quote.schedule.label}</a>
          <a class="btn btn--ghost btn--big" href={quoteFallback(c.lang)} data-roofle-open>{c.quote.button}</a>
          <p class="final">{c.quote.call} <a href={site.phoneHref}>{site.phone}</a></p>
          <p class="hablamos">{c.quote.note}</p>
        </div>
      </div>
    </div>
  </section>

  {/* Services: the visitor picks a path first. */}
  <section class="section">
    <div class="wrap center">
      <h2>{c.services.title}</h2>
      <p class="lead" set:html={c.services.lead} />
    </div>
    <div class="wrap services">
      {c.services.items.map((s, i) => (
        <article class="service">
          <Image src={serviceImgs[i]} alt={s.alt} widths={[400, 640, 800]} sizes="(max-width: 900px) 100vw, 380px" class="rounded" />
          <p class="eyebrow">{s.eyebrow}</p>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
          <a class="btn" href={s.href}>{s.button}</a>
        </article>
      ))}
    </div>
  </section>

  {/* Reviews */}
  <section class="section soft" id="reviews">
    <div class="wrap center">
      <p class="eyebrow">{c.reviews.eyebrow}</p>
      <h2>{c.reviews.title}</h2>
      <p class="lead">{c.reviews.lead}</p>
    </div>
    <div class="wrap">
      <GoogleReviews lang={c.lang} show={3} more={c.reviews.more} />
    </div>
    <div class="wrap center actions">
      <a class="btn" href={site.googleMaps} rel="noopener" target="_blank">{c.reviews.link}</a>
    </div>
  </section>

  {/* Why Edel: three promises, then credentials and badges. */}
  <section class="section">
    <div class="wrap center">
      <p class="eyebrow">{c.why.eyebrow}</p>
      <h2>{c.why.title}</h2>
      <p class="lead">{c.why.lead}</p>
    </div>
    <div class="wrap proof-grid">
      {c.why.cards.map((card, i) => (
        <div class="proof-card">
          <Icon name={whyIcons[i]} />
          <h3 set:html={card.title} />
          <p set:html={card.body} />
        </div>
      ))}
    </div>
    <p class="wrap center credentials" set:html={c.why.credentials} />
    <ul class="wrap badges">
      {badges.map((b) => (
        <li>
          <Image src={b.src} alt="" height={90} />
          <span>{b.label}</span>
        </li>
      ))}
    </ul>
    <div class="wrap center actions">
      <a class="btn" href={c.why.projects.href}>{c.why.projects.label}</a>
      <a class="btn btn--ghost" href={c.why.about.href}>{c.why.about.label}</a>
    </div>
  </section>

  {/* What happens next */}
  <section class="section photo-band" style={truckBg}>
    <div class="wrap center">
      <p class="eyebrow">{c.steps.eyebrow}</p>
      <h2>{c.steps.title}</h2>
      <ol class="steps">
        {c.steps.items.map((st, i) => (
          <li>
            <span class="num">{i + 1}</span>
            <h3>{st.title}</h3>
            <p set:html={st.body} />
          </li>
        ))}
      </ol>
      <a class="btn btn--white" href={c.steps.button.href}>{c.steps.button.label}</a>
      <div class="finance">
        <h3>{c.steps.financing.title}</h3>
        <p>{c.steps.financing.body}</p>
        <a class="btn btn--light" href={c.steps.financing.button.href}>{c.steps.financing.button.label}</a>
      </div>
    </div>
  </section>

  {c.form && (
    <section class="section">
      <div class="wrap form-wrap">
        <h2>{c.form.title}</h2>
        <LeadForm id="home-contact" lang={c.lang} submit={c.form.submit} fields={c.form.fields} endpoint={c.lang === 'es' ? forms.contactEs : undefined} />
      </div>
    </section>
  )}

  {/* Areas + map */}
  <section class="section warm">
    <div class="wrap split">
      <div>
        <p class="eyebrow">{c.areas.eyebrow}</p>
        <h2>{c.areas.title}</h2>
        <p>{c.areas.lead}</p>
        <ul class="areas">
          {areas.map((a) => (
            <li>
              {a.href ? (
                <a class:list={['area', { home: a.home }]} href={a.href}>
                  <span class="area-name">{a.name}{!a.home && <Icon name="arrow" />}</span>
                  {a.home && <small>{c.areas.homeLabel}</small>}
                </a>
              ) : (
                <span class="area">{a.name}</span>
              )}
            </li>
          ))}
        </ul>
        <a class="btn" href={c.areas.buttonHref}>{c.areas.button}</a>
        <p class="small" set:html={c.areas.small} />
      </div>
      <div>
        <div class="map">
          <iframe
            title={c.areas.mapTitle}
            src={mapEmbed}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen></iframe>
        </div>
        <p class="small">{addressLine}</p>
      </div>
    </div>
  </section>

  {/* FAQ, before the closing call */}
  <section class="section">
    <div class="wrap faq-wrap">
      <div class="center">
        <p class="eyebrow">{c.faq.eyebrow}</p>
        <h2>{c.faq.title}</h2>
      </div>
      <div class="faqs">
        {c.faq.items.map((f) => (
          <details>
            <summary>{f.q}<Icon name="plus" /></summary>
            <p set:html={f.a} />
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* Closing call */}
  <section class="cta" style={ctaBgSrc}>
    <div class="wrap cta-row">
      <div>
        <h2>{c.cta.title}</h2>
        <p set:html={c.cta.body} />
        <p class="promise">{c.promise}</p>
      </div>
      <div class="cta-actions">
        <a class="btn btn--white" href={c.cta.schedule.href}>{c.cta.schedule.label}</a>
        <a class="btn btn--light" href={site.phoneHref}><Icon name="phone" />{c.cta.call} {site.phone}</a>
        <p class="cta-note">{c.cta.note}</p>
      </div>
    </div>
  </section>


<style>
  .section { padding-block: 88px; }
  .soft { background: var(--bg-soft); }
  .warm { background: var(--bg-warm); }
  .center { text-align: center; }
  .center .eyebrow { justify-content: center; }
  .narrow { max-width: 860px; }
  .lead { max-width: 62ch; margin: 0 auto 1.6rem; }
  .small { font-size: 14px; margin-top: 1rem; }
  .rounded { border-radius: var(--radius); width: 100%; object-fit: cover; }
  h2 {
    font-size: clamp(32px, 4.4vw, 52px);
    text-transform: uppercase;
  }

  /* Hero */
  .hero {
    position: relative;
    isolation: isolate;
    color: var(--white);
    background: var(--maroon-dark) var(--bg) center / cover no-repeat;
    padding-block: 56px 72px;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(100deg, rgba(45, 0, 1, 0.92) 0%, rgba(45, 0, 1, 0.82) 50%, rgba(45, 0, 1, 0.45) 100%);
  }
  /* Grid children may shrink, so the longer Spanish rating line wraps. */
  .hero-copy, .hero-side { min-width: 0; }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: center;
  }
  .rating {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 16px;
    color: var(--white);
    text-decoration: none;
    margin-bottom: 18px;
  }
  .rating:hover span:last-child { text-decoration: underline; }
  .stars { display: inline-flex; gap: 2px; color: #f5b301; }
  .stars :global(svg) { width: 22px; height: 22px; }
  .hero h1 {
    font-size: clamp(38px, 4.8vw, 60px);
    font-weight: 600;
    line-height: 1.08;
    color: var(--white);
    margin-bottom: 22px;
    max-width: 20ch;
  }
  .assure { list-style: none; margin: 0 0 20px; padding: 0; display: grid; gap: 10px; }
  .assure li { display: flex; align-items: center; gap: 10px; font-size: 16px; font-weight: 600; }
  .assure :global(svg) { width: 22px; height: 22px; flex: none; color: #f2c4c8; }
  .hero-text { font-size: 17px; max-width: 46ch; color: rgba(255, 255, 255, 0.9); margin: 0; }

  .hero-side { position: relative; display: grid; justify-items: center; }
  .quote-card {
    position: relative;
    width: 100%;
    max-width: 440px;
    background: var(--white);
    color: var(--ink);
    border-radius: 14px;
    padding: 26px 26px 20px;
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.28);
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 12px;
    padding: 6px 14px;
    border-radius: 999px;
    background: #f6eaeb;
    color: var(--maroon);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--maroon-mid); }
  .quote-card h2 {
    font-size: 30px;
    text-transform: none;
    color: var(--maroon);
    margin-bottom: 8px;
  }
  .quote-card p { font-size: 15px; }
  .btn--big { display: flex; width: 100%; min-height: 56px; font-size: 16px; gap: 8px; margin-top: 10px; }
  .btn--big :global(svg) { width: 18px; height: 18px; }
  .final { margin: 12px 0 0; font-size: 14px; text-align: center; color: var(--ink); }
  .hablamos { margin: 6px 0 0; text-align: center; font-size: 14px; font-weight: 600; color: var(--muted); }

  /* Services: three cards */
  .services {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 28px;
    margin-top: 36px;
  }
  .service { display: flex; flex-direction: column; text-align: left; flex: 0 1 calc((100% - 56px) / 3); }
  .service :global(img) { aspect-ratio: 4 / 3; margin-bottom: 18px; }
  .service h3 { font-size: clamp(26px, 2.6vw, 32px); text-transform: uppercase; margin-bottom: 8px; }
  .service p:not(.eyebrow) { flex: 1; }
  .service .btn { align-self: flex-start; margin-top: 8px; }

  /* Proof */
  .text-link { display: inline-flex; align-items: center; gap: 6px; margin-top: 16px; font-weight: 600; color: var(--maroon); }
  .text-link :global(svg) { width: 16px; height: 16px; }
  .proof-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 44px;
  }
  .proof-card { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: 26px 24px; }
  .proof-card :global(svg) { width: 34px; height: 34px; color: var(--maroon); }
  .proof-card h3 { font-size: 26px; text-transform: uppercase; margin: 12px 0 6px; }
  .proof-card p { margin: 0; }
  .badges {
    list-style: none;
    margin-block: 44px 0;
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 20px;
    align-items: start;
  }
  .badges li { display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center; }
  .badges :global(img) { height: 72px; width: auto; }
  .badges span { font-size: 12px; font-weight: 600; line-height: 1.35; color: var(--ink); }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 40px; }

  /* Split */
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }

  /* Steps band */
  .photo-band {
    position: relative;
    color: var(--white);
    background: var(--maroon-dark) var(--bg) center / cover no-repeat;
    isolation: isolate;
  }
  .photo-band::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(79, 0, 0, 0.92);
    z-index: -1;
  }
  .photo-band h2, .photo-band h3 { color: var(--white); }
  .photo-band .eyebrow { color: #f2c4c8; }
  .photo-band .eyebrow::before { background: #f2c4c8; }
  .steps {
    list-style: none;
    padding: 0;
    margin: 36px 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    margin-bottom: 36px;
  }
  .steps li p { max-width: 32ch; margin-inline: auto; }
  .steps li p :global(a) { color: var(--white); font-weight: 600; white-space: nowrap; }
  .num {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid #f2c4c8;
    font-family: var(--font-head);
    font-size: 22px;
    font-weight: 700;
  }
  .steps h3 { font-size: 28px; text-transform: uppercase; margin: 12px 0 6px; }
  .finance {
    max-width: 760px;
    margin: 48px auto 0;
    padding: 32px 28px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: var(--radius);
    background: rgba(0, 0, 0, 0.18);
  }
  .finance h3 { font-size: 28px; text-transform: uppercase; margin: 0 0 8px; }
  .finance p { margin: 0 0 18px; }
  .promise { font-family: var(--font-head); font-size: 20px; font-weight: 600; letter-spacing: 0.02em; margin: 0 0 14px; }
  .credentials { max-width: 70ch; margin-top: 36px; font-weight: 600; color: var(--ink); }
  .cta-note { margin: 4px 0 0; font-weight: 600; text-align: center; }

  /* Areas */
  .areas {
    list-style: none;
    padding: 0;
    margin: 24px 0 28px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 12px;
  }
  .area {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 64px;
    padding: 10px 12px;
    text-align: center;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    font-weight: 600;
    color: var(--ink-strong);
    text-decoration: none;
  }
  /* Only Edinburg, McAllen and Mission have pages: those cards get the
     maroon edge and an arrow so the plain ones don't read as broken links. */
  a.area { border-left: 3px solid var(--maroon); color: var(--maroon); }
  a.area:hover { border-color: var(--maroon); box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08); }
  span.area { background: transparent; border-style: dashed; font-weight: 500; color: var(--muted); }
  .area-name { display: inline-flex; align-items: center; justify-content: center; gap: 6px; }
  .area-name :global(svg) { width: 16px; height: 16px; flex: none; }
  .area.home { background: var(--maroon-mid); border-color: var(--maroon-mid); color: var(--white); }
  .area small { font-size: 11px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; margin-top: 4px; }

  /* Map */
  .map { aspect-ratio: 4 / 3; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); }
  .map iframe { width: 100%; height: 100%; border: 0; }

  /* CTA */
  .cta {
    position: relative;
    isolation: isolate;
    color: var(--white);
    background: var(--maroon) var(--bg) center / cover no-repeat;
    padding-block: 64px;
  }
  .cta::before { content: ''; position: absolute; inset: 0; background: rgba(79, 0, 0, 0.8); z-index: -1; }
  .cta-row { display: flex; align-items: center; justify-content: space-between; gap: 32px; }
  .cta h2 { color: var(--white); font-size: clamp(30px, 3.6vw, 44px); }
  .cta p { max-width: 60ch; margin: 0; }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 12px; flex: none; }
  .cta-actions .btn { gap: 8px; }
  .cta-actions :global(svg) { width: 18px; height: 18px; }
  .btn--white { background: var(--white); border-color: var(--white); color: var(--maroon); }
  .btn--white:hover { background: #f6eaeb; border-color: #f6eaeb; color: var(--maroon); }

  /* FAQ */
  .faq-wrap { max-width: 900px; }
  .form-wrap { max-width: 760px; }
  .form-wrap h2 { text-align: center; margin-bottom: 24px; }
  .faqs { display: grid; gap: 12px; margin-top: 28px; }
  details {
    background: var(--white);
    border: 1px solid var(--line);
    border-left: 3px solid var(--maroon);
    border-radius: var(--radius);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 18px 20px;
    cursor: pointer;
    font-weight: 600;
    color: var(--ink-strong);
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary :global(svg) { width: 18px; height: 18px; color: var(--maroon); flex: none; transition: transform 0.15s ease; }
  details[open] summary :global(svg) { transform: rotate(45deg); }
  details p { padding: 0 20px 18px; margin: 0; }
  details p :global(a) { color: var(--maroon); font-weight: 600; }

  @media (max-width: 900px) {
    .section { padding-block: 60px; }
    .services, .proof-grid, .steps { grid-template-columns: 1fr; }
    .services { gap: 40px; }
    .service { flex-basis: 100%; }
    .badges { grid-template-columns: repeat(4, 1fr); }
    .hero { padding-block: 28px 40px; }
    .hero::before { background: rgba(45, 0, 1, 0.85); }
    .hero-grid, .split { grid-template-columns: 1fr; gap: 32px; }
    .hero-grid { gap: 24px; }
    .quote-card { max-width: none; }
  }
  @media (max-width: 600px) {
    /* Keep the quote button on the first phone screen. */
    .hero .promise { font-size: 16px; margin-bottom: 10px; }
    .hero { padding-block: 18px 32px; }
    .hero-grid { gap: 18px; }
    .rating { gap: 8px; font-size: 14px; margin-bottom: 12px; flex-wrap: nowrap; }
