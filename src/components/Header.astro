---
// One slim sticky row: logo, menu, phone, quote button. Address, email and
// social links live in the footer. Mobile: logo, round call button, menu.
import { Image } from 'astro:assets';
import logo from '../assets/edel-logo.png';
import { site, mainNav, mainNavEs } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  lang?: 'en' | 'es';
  // The other-language twin of this page; falls back to that language's home.
  switchHref?: string;
  // Where the quote button goes on pages without Roofle (the ads page points
  // it at its own form so ad clicks don't leave for /contact-us).
  quoteHref?: string;
}
const { lang = 'en', switchHref, quoteHref } = Astro.props;
const quote = quoteHref ? { href: quoteHref } : { href: '/contact-us', 'data-roofle-open': '' };
const es = lang === 'es';
const nav = es ? mainNavEs : mainNav;
const home = es ? '/es-mx' : '/';
const t = es
  ? { quote: 'Cotización Instantánea', call: 'Llamar', menu: 'Menú', main: 'Principal', switchLabel: 'English', switchLang: 'en', homeLabel: 'Edel Roofing & Construction, inicio' }
  : { quote: 'Get Instant Quote', call: 'Call', menu: 'Menu', main: 'Main', switchLabel: 'Español', switchLang: 'es', homeLabel: 'Edel Roofing & Construction home' };
// "Instant" only fits Roofle; the ads page form is a callback request.
const quoteLabel = quoteHref ? (es ? 'Cotización Gratis' : 'Get Free Quote') : t.quote;
const langHref = switchHref ?? (es ? '/' : '/es-mx');
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === home ? path === home : path === href);
---
<header class="site-header">
  <div class="bar">
    <a class="logo" href={home} aria-label={t.homeLabel}>
      <Image src={logo} alt="Edel Roofing & Construction Inc" width={150} densities={[1, 2]} loading="eager" />
    </a>

    <nav class="desktop-nav" aria-label={t.main}>
      <ul class="menu">
        {nav.map((item) => (
          <li class={item.children ? 'has-sub' : undefined}>
            <a href={item.href} class:list={[{ active: isActive(item.href) }]}>
              {item.label}{item.children && <Icon name="chevron" />}
            </a>
            {item.children && (
              <ul class="sub">
                {item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <a class="lang" href={langHref} hreflang={t.switchLang} lang={t.switchLang}>{t.switchLabel}</a>
      <a class="phone" href={site.phoneHref}>
        <Icon name="phone" />
        <span>{site.phone}</span>
      </a>
      <a class="btn quote" {...quote}>{quoteLabel}</a>

      <a class="call-round" href={site.phoneHref} aria-label={`${t.call} Edel Roofing ${site.phone}`}>
        <Icon name="phone" />
      </a>
      <details class="mobile-menu">
        <summary aria-label={t.menu}><Icon name="menu" /></summary>
        <div class="drawer">
          <ul>
            {nav.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
                {item.children && (
                  <ul>{item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}</ul>
                )}
              </li>
            ))}
          </ul>
          <a class="btn" {...quote}>{quoteLabel}</a>
          <a class="btn btn--ghost" href={site.phoneHref}>{t.call} {site.phone}</a>
          <a class="drawer-lang" href={langHref} hreflang={t.switchLang} lang={t.switchLang}>{t.switchLabel}</a>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Same-page links in the phone menu (the ads page quote button) close it.
  document.querySelectorAll<HTMLAnchorElement>('.mobile-menu .drawer a[href^="#"]').forEach((a) =>
    a.addEventListener('click', () => a.closest('details')?.removeAttribute('open')),
  );
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--white);
    border-bottom: 1px solid var(--line);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
  }
  .bar {
    max-width: 1320px;
    margin-inline: auto;
    padding: 10px var(--gutter);
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .logo { flex: none; display: block; }
  .logo :global(img) { width: 150px; height: auto; }

  .desktop-nav { flex: 1; }
  .menu { list-style: none; display: flex; justify-content: center; gap: 4px 24px; margin: 0; padding: 0; }
  .menu > li { position: relative; }
  .menu > li > a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 14px 0;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
    color: var(--ink-strong);
  }
  .menu > li > a:hover,
  .menu > li > a.active { color: var(--maroon-mid); }
  .menu > li > a.active { box-shadow: inset 0 -2px 0 var(--maroon-mid); }
  .menu :global(svg) { width: 12px; height: 12px; }
  .sub {
    list-style: none;
    margin: 0;
    padding: 8px 0;
    position: absolute;
    top: 100%;
    left: -16px;
    min-width: 220px;
    background: var(--white);
    border-top: 3px solid var(--maroon);
    border-radius: 0 0 var(--radius) var(--radius);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
  }
  .has-sub:hover .sub,
  .has-sub:focus-within .sub { opacity: 1; visibility: visible; transform: none; }
  .sub a { display: block; padding: 9px 18px; font-size: 14px; text-decoration: none; }
  .sub a:hover { background: var(--bg-soft); color: var(--maroon); }

  .actions { display: flex; align-items: center; gap: 18px; flex: none; }
  .phone {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 16px;
    color: var(--maroon);
    text-decoration: none;
  }
  .phone :global(svg) { width: 18px; height: 18px; }
  .phone:hover span { text-decoration: underline; }
  .quote { min-height: 44px; }
  .lang { font-size: 13px; font-weight: 600; color: var(--muted); text-decoration: none; white-space: nowrap; }
  .lang:hover { color: var(--maroon); text-decoration: underline; }
  .drawer-lang { text-align: center; margin-top: 8px; color: var(--maroon); font-weight: 600; text-decoration: underline; }

  .call-round,
  .mobile-menu { display: none; }

  /* No room for the language link next to the phone below 1367px; it is in
     the footer and (under 1025px) the menu drawer. */
  @media (max-width: 1366px) { .lang { display: none; } }

  @media (max-width: 1200px) {
    .menu { gap: 4px 16px; }
    .menu > li > a { font-size: 13px; }
    .phone span { display: none; }
  }

  @media (max-width: 1024px) {
    .bar { justify-content: space-between; padding-block: 8px; }
    .logo :global(img) { width: 116px; }
    .desktop-nav,
    .phone,
    .lang,
    .quote { display: none; }
    .actions { gap: 12px; }
    .call-round {
      display: grid;
      place-items: center;
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: var(--maroon);
      color: var(--white);
    }
    .call-round :global(svg) { width: 24px; height: 24px; }
    .mobile-menu { display: block; }
    .mobile-menu summary {
      list-style: none;
      display: grid;
      place-items: center;
      width: 48px;
      height: 48px;
      cursor: pointer;
      color: var(--maroon);
    }
    .mobile-menu summary::-webkit-details-marker { display: none; }
    .mobile-menu summary :global(svg) { width: 30px; height: 30px; }
    .drawer {
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      background: var(--white);
      border-top: 3px solid var(--maroon);
      box-shadow: 0 16px 30px rgba(0, 0, 0, 0.15);
      padding: 8px 16px 20px;
      max-height: calc(100vh - 72px);
      overflow-y: auto;
    }
    .drawer ul { list-style: none; margin: 0; padding: 0; }
    .drawer > ul > li { border-bottom: 1px solid var(--line); }
    .drawer a { display: block; padding: 12px 4px; text-decoration: none; font-weight: 500; }
    .drawer ul ul a { padding: 8px 4px 8px 20px; font-weight: 400; font-size: 14px; color: var(--muted); }
    .drawer .btn { display: flex; margin-top: 12px; }
    .drawer .btn:not(.btn--ghost) { color: var(--white); }
  }
</style>
